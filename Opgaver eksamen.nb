Cell[TextData[{
 "Vi starter med sensitivtetsanalyse af objektivkoefficienterne. \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "3"], ":"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "23248115-46bc-3146-bf98-cc82a231c431"],
 "\nDenne variabel indg\[ARing]r ikke i basis, og dermed kan den \
tilh\[OSlash]rende objektivkoefficient falde uendeligt, uden at dette ville \
inkludere den i basisen. Den tilladte stigning bestemmes af reduced cost for \
samme variabel, som bliver 30. Dermed kan ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cdd078d0-e825-8545-9185-4f37931f4d4a"],
 " koefficienten varierer i intervallet ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"[", 
     RowBox[{
      RowBox[{"-", "\[Infinity]"}], ";", 
      RowBox[{"80", "+", "30"}]}], "]"}], " ", "=", " ", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{"-", "\[Infinity]"}], ";", "110"}], "]"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cee453b3-e74e-4643-bc1f-984a6e0fdada"],
 ".\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "1"], ":"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fcf0125e-e0db-4e48-8a29-0169358bcfb1"],
 "\nDette er en basisvariabel. Vi bem\[AE]rker f\[OSlash]rst at der \
b\[ARing]de findes v\[AE]rdier i den tiilh\[OSlash]rende r\[AE]kke, som er st\
\[OSlash]rre end nul og mindre end nul. Dermed bliver hverken den \
\[OSlash]vre eller den nedre gr\[AE]nse \[Infinity]. Vi finder maksimalt \
fald, ved at beregner ratiosne mellem v\[AE]rdierne i z-r\[AE]kken og \
v\[AE]rdierne i ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a5287451-4f3f-074e-b0a5-ee95f70e19c0"],
 " r\[AE]kken (dog uden f\[OSlash]rste position i denne vektor, da det er \
pivotpositionen):"
}], "Text",
 CellChangeTimes->{{3.9784351886987743`*^9, 
  3.9784355156047726`*^9}},ExpressionUUID->"1764ecbb-4cd5-e046-ab53-\
3c5d557872ba"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"30", "/", 
    RowBox[{"(", 
     RowBox[{"5", "/", "2"}], ")"}]}], ",", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"80", "/", "3"}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"2", "/", "3"}], ")"}]}]}], "}"}]], "Input",
 CellChangeTimes->{{3.978435526316246*^9, 3.978435560600033*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"7b793d09-041e-6a40-b05c-74c366a0460e"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{"12", ",", "40"}], "}"}], TraditionalForm]], "Output",
 CellChangeTimes->{3.9784355619360485`*^9},
 CellLabel->"Out[4]=",ExpressionUUID->"675be07d-edd6-cc4f-bb8f-c2c16cefdc23"]
}, Open  ]],

Cell[TextData[{
 "Vi ser at den laveste af disse to er 12. Dermed bliver det tilladte fald \
for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["c", "1"], "=", "60"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "81dd4820-b8b5-3a46-a851-7b245e1ebcc3"],
 " alts\[ARing] v\[AE]rdien 12. Den maksimale stigning er givet ved"
}], "Text",
 CellChangeTimes->{{3.978435564288971*^9, 
  3.9784356207817993`*^9}},ExpressionUUID->"8732dc23-af8c-b84e-b2f3-\
0e7c11eacc44"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"-", 
   RowBox[{"(", 
    RowBox[{"10", "/", "3"}], ")"}]}], "/", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", "1"}], "/", "6"}], ")"}]}]], "Input",
 CellChangeTimes->{{3.9784356274829273`*^9, 3.978435639167879*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"2d9cdde7-4497-a243-a418-307fed405b85"],

Cell[BoxData[
 FormBox["20", TraditionalForm]], "Output",
 CellChangeTimes->{3.9784356399234753`*^9},
 CellLabel->"Out[5]=",ExpressionUUID->"31ac15d8-baec-ba40-aa57-abc09656a744"]
}, Open  ]],

Cell[TextData[{
 "Dermed bliver intervallet for denne objektivkoefficient ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"[", 
     RowBox[{
      RowBox[{"60", "-", "12"}], ";", 
      RowBox[{"60", "+", "20"}]}], "]"}], " ", "=", " ", 
    RowBox[{"[", 
     RowBox[{"48", ";", "80"}], "]"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d279d895-9ef6-fa4c-89ff-32809f701a06"],
 ".\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "2"], ":"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8e0ae60c-c3ec-5644-a40e-462a2b1e5653"]
}], "Text",
 CellChangeTimes->{{3.978435648765848*^9, 
  3.9784357414559*^9}},ExpressionUUID->"f0cb0604-b9bb-c148-9d0c-3b196ae7e25a"],

Cell["\<\
Denne variabel indg\[ARing]r heller ikke i basis, og der er b\[ARing]de \
positive og negative v\[AE]rdier i r\[AE]kken. Dermed bliver maksimal stigning\
\>", "Text",
 CellChangeTimes->{{3.9784357551567574`*^9, 3.9784357739342556`*^9}, {
  3.9784360009592113`*^9, 
  3.9784360058068542`*^9}},ExpressionUUID->"e2ff6616-157e-b24d-a24c-\
dd891e49cf2a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"-", "30"}], "/", 
    RowBox[{"-", "1"}]}], ",", 
   RowBox[{"-", 
    FractionBox[
     FractionBox[
      RowBox[{"-", "80"}], "3"], 
     RowBox[{"1", "/", "3"}]]}]}], "}"}]], "Input",
