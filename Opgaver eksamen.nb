  3.9786179564316273`*^9}},ExpressionUUID->"7c241210-da49-c748-83e5-\
8be7bdd0e319"],

Cell["\<\
Vi tr\[AE]kker den nedrundede ligning fra den ikke-nedrundede ligning\
\>", "Text",
 CellChangeTimes->{{3.978617958675844*^9, 
  3.9786179834011765`*^9}},ExpressionUUID->"7e107191-db2a-a14d-a22c-\
4f4363dd36a3"],

