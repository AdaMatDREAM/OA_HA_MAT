           RowBox[{
            SubscriptBox["T", "q"], 
            RowBox[{"(", "N", ")"}]}], "]"}]}], "+", 
         RowBox[{"N", "*", "180000"}]}]}
      },
      GridBoxAlignment->{"Columns" -> {{"Center"}}}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
  TraditionalForm]],ExpressionUUID->"f0ff188a-7894-bc4d-bd49-6bfdba6a15f4"]], \
