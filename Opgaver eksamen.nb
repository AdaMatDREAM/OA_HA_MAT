Cell[TextData[{
 "Hvis vi v\[AE]lger ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1d949141-6789-a645-a261-aecee2d6fb0b"],
 " som variablen vi vil udf\[OSlash]re en et \[OpenCurlyDoubleQuote]cut\
\[CloseCurlyDoubleQuote] p\[ARing], har vi f\[OSlash]lgende ligning"
}], "Text",
 CellChangeTimes->{{3.9786176247706966`*^9, 3.9786176462793903`*^9}, {
  3.978617867508232*^9, 
  3.978617871601343*^9}},ExpressionUUID->"06fc05de-725e-8341-a7fb-\
c8453a60c5d7"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {GridBox[{
       {
        RowBox[{
         RowBox[{
          SubscriptBox["x", "1"], "-", 
          SubscriptBox["x", "3"], "+", 
          RowBox[{"2", 
           SubscriptBox["s", "1"]}], "-", 
          RowBox[{"0.03", 
           SubscriptBox["s", "3"]}]}], "=", "1.5"}]}
      },
      GridBoxAlignment->{"Columns" -> {{"Center"}}}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
  TraditionalForm]],ExpressionUUID->"490ac834-3e02-9046-b3a8-917bd819fe51"]], \
