Cell[TextData[{
 "Vi ser at den optimale v\[AE]rdi for objektivfunktionen er 175. Her \
produceres 125 enheder af ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2f71098f-13ef-e440-9e62-5af9a8b541f6"],
 " og 25 enheder af ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "82f6cd03-ef00-9641-b384-09e43a93eeac"],
 ". Desuden ser vi at tredje bibetingelse ikke er aktiv. "
}], "Text",
 CellChangeTimes->{{3.9778273220418587`*^9, 3.977827352723753*^9}, {
  3.97782738614431*^9, 
  3.9778274016854496`*^9}},ExpressionUUID->"aa2e5416-896b-8b4e-8e34-\
04750b6eaf26"]
}, Open  ]]
}, Closed]],

