Cell[TextData[{
 "Ud fra vores skitse, kan vi se at bibetingelsen ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"3", 
      SubscriptBox["x", "1"]}], "+", 
     RowBox[{"4", 
      SubscriptBox["x", "2"]}]}], ">=", "60"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8ea3ba3b-c8c5-fb45-a89b-8412507625d2"],
 " er overfl\[OSlash]dig. Den bidrager ikke med noget ny information, da den \
aldrig er aktiv alene. Denne kan vi alts\[ARing] med fordel smide v\[AE]k, \
eftersom problemet ville v\[AE]re det samme, hvis denne ikke var der. "
}], "Text",
 CellChangeTimes->{{3.977825018701107*^9, 
  3.9778251236067753`*^9}},ExpressionUUID->"017b39ab-0009-0546-b278-\
dccd3ffb1578"]
}, Open  ]],

Cell[CellGroupData[{

Cell["(c)", "Subsection",
 CellChangeTimes->{{3.9778255448413773`*^9, 
  3.97782554542354*^9}},ExpressionUUID->"ed536c7c-734a-984c-9ffc-\
87a8a0cbebd7"],

Cell["\<\
Ved at gange objektivfunktionen med minus et, kan vi omdanne problemet fra et \
minimeringsproblem, til et maksimeringsproblem. Det samme kan vi g\[OSlash]re \
for bibetingelserne, s\[ARing] de passer i simplex algoritmen. Da bliver \
problemet\
\>", "Text",
 CellChangeTimes->{{3.977825550346733*^9, 3.9778255847427998`*^9}, {
  3.9778257251389904`*^9, 
  3.9778257413829193`*^9}},ExpressionUUID->"af8c22b8-d17a-e645-817c-\
4683995e2fa8"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {GridBox[{
       {
        RowBox[{"max", " ", "-", 
         RowBox[{"4", 
          SubscriptBox["x", "1"]}], "-", 
         RowBox[{"7", 
          SubscriptBox["x", "2"]}]}]},
       {
        RowBox[{"u", ".", "b", ".", "b"}]},
       {
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"-", "2"}], 
           SubscriptBox["x", "1"]}], "-", 
          RowBox[{"3", 
           SubscriptBox["x", "2"]}]}], "<=", 
         RowBox[{"-", "42"}]}]},
       {
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"-", "3"}], 
           SubscriptBox["x", "1"]}], "-", 
          RowBox[{"4", 
           SubscriptBox["x", "2"]}]}], "<=", 
         RowBox[{"-", "60"}]}]},
       {
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           SubscriptBox["x", "1"]}], "-", 
          SubscriptBox["x", "2"]}], "<=", 
         RowBox[{"-", "18"}]}]},
