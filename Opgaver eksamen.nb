Cell[CellGroupData[{

Cell["(a)", "Subsection",
 CellChangeTimes->{{3.9778292252639847`*^9, 
  3.9778292256932945`*^9}},ExpressionUUID->"957c70a1-dcbb-3e4d-aaea-\
26275cb1e328"],

Cell[TextData[{
 "For at ops\[AE]tte modellen, starter vi med at danne os et overblik. Vi har \
beslutningsvariablene\nbulk carrier ",
 Cell[BoxData[
  FormBox[
   RowBox[{"=", 
    RowBox[{
     SubscriptBox["x", "1"], "->", 
     RowBox[{"salgspris", " ", "120", " ", 
      RowBox[{"mio", ".", " ", "euro"}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "341f0bd7-4790-a847-b07a-306c7c91b2d1"],
 "\nRORO ship ",
 Cell[BoxData[
  FormBox[
   RowBox[{"=", 
    RowBox[{
     SubscriptBox["x", "2"], "->", " ", 
     RowBox[{"salgspris", " ", "200", " ", 
      RowBox[{"mio", ".", " ", "euro"}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "25ec1a2a-41ab-fa47-9448-45315b0d3953"],
 "\ncontainer ",
 Cell[BoxData[
  FormBox[
   RowBox[{"ship", "=", 
    RowBox[{
     SubscriptBox["x", "3"], "->", " ", 
     RowBox[{"sallgspris", " ", "260", " ", 
      RowBox[{"mio", ".", " ", "euro"}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a48e3b5f-3d17-e745-b656-64fd9e219b26"],
 "\nVi laver desuden en oversigt over hvor rescourcebrug og kapacitet for de \
forskellige beslutningsvariable"
}], "Text",
 CellChangeTimes->{{3.9778275477130985`*^9, 
  3.9778276938620453`*^9}},ExpressionUUID->"fcd4c7e4-77a2-e642-abdd-\
6e10b510068c"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {GridBox[{
       {
        TagBox[GridBox[{
           {
            RowBox[{"Rescource", "/", "skipstype"}], 
            SubscriptBox["x", "1"], 
            SubscriptBox["x", "2"], 
            SubscriptBox["x", "3"], "Kapacitet"},
           {
            RowBox[{"B1", ":", " ", "Docks"}], "1", "1", "1", "11"},
           {
            RowBox[{"B2", ":", " ", "Labour"}], "30", "15", "45", "300"},
           {
            RowBox[{"B3", ":", " ", "Kapital"}], "40", "80", "120", "820"}
          },
          GridBoxDividers->{"Columns" -> {{True}}, "Rows" -> {{True}}}],
         "Grid"]}
      },
      GridBoxAlignment->{"Columns" -> {{"Center"}}}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
  TraditionalForm]],ExpressionUUID->"a59f379c-e6c1-2b42-aa36-0f38d84dfb42"]], \
"Text",
 CellChangeTimes->{{3.97782769771665*^9, 3.977827727511553*^9}, {
  3.9778277876580906`*^9, 
  3.9778279054896927`*^9}},ExpressionUUID->"28ef067e-0239-f94f-994b-\
673297d5e7b0"],

Cell["\<\
Man kan ikke producerer negative m\[AE]ngder, hvilket ogs\[ARing] \
inds\[AE]ttes i modellen. Dermed har vi f\[OSlash]lgende model\
\>", "Text",
 CellChangeTimes->{{3.9778279152412987`*^9, 
  3.977827937770481*^9}},ExpressionUUID->"b7a85c7f-c393-4f4d-a983-\
09e208eeb5a8"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {GridBox[{
       {
        RowBox[{
         RowBox[{"max", " ", "120", 
          SubscriptBox["x", "1"]}], "+", 
         RowBox[{"200", 
          SubscriptBox["x", "2"]}], "+", 
         RowBox[{"260", 
          SubscriptBox["x", "3"]}]}]},
       {
        RowBox[{"u", ".", "b", ".", "b"}]},
       {
        RowBox[{
         RowBox[{
          SubscriptBox["x", "1"], "+", 
          SubscriptBox["x", "2"], "+", 
          SubscriptBox["x", "3"]}], "<=", "11"}]},
       {
        RowBox[{
         RowBox[{
          RowBox[{"30", 
           SubscriptBox["x", "1"]}], "+", 
          RowBox[{"15", 
           SubscriptBox["x", "2"]}], "+", 
          RowBox[{"45", 
           SubscriptBox["x", "3"]}]}], "<=", "300"}]},
       {
        RowBox[{
         RowBox[{
          RowBox[{"40", 
           SubscriptBox["x", "1"]}], "+", 
          RowBox[{"80", 
           SubscriptBox["x", "2"]}], "+", 
          RowBox[{"120", 
           SubscriptBox["x", "3"]}]}], "<=", "820"}]},
       {
        RowBox[{
         SubscriptBox["x", "1"], ",", 
         SubscriptBox["x", "2"], ",", 
         RowBox[{
          SubscriptBox["x", "3"], ">=", "0"}]}]}
      },
      GridBoxAlignment->{"Columns" -> {{"Center"}}}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
  TraditionalForm]],ExpressionUUID->"f723b4e4-b996-3440-9fe9-5976266acc2a"]], \
"Text",
 CellChangeTimes->{{3.9778279403345413`*^9, 3.9778280076987114`*^9}, {
  3.9778280399291077`*^9, 
  3.977828056226513*^9}},ExpressionUUID->"b2d49050-05e6-224a-b82d-\
a5a68bdc1084"],

Cell["\<\
Vi har antaget at kan gange op i bibetinglser og salg uden at de \
p\[ARing]virker m\[AE]ngden man benytter. Alt er alts\[ARing] perfekt \
skalerbart.  Vi har antaget at man ikke kan producere negative m\[AE]ngder. \
Vi har antaget divisibilitet og perfekt viden. Vi har antaget at b\[ARing]de \
begr\[AE]nsninger og objektivfunktionen bare er linearkombinationer. Vi har \
antaget at man godt kan bygge halve skibe (kontinuitet).\
\>", "Text",
 CellChangeTimes->{{3.9778289593389816`*^9, 3.9778290239016647`*^9}, {
  3.977829060920225*^9, 3.977829120705183*^9}, {3.977829229715805*^9, 
  3.9778292302029057`*^9}},ExpressionUUID->"713aa315-9661-c144-9ffa-\
03db3fd6ca47"]
}, Open  ]],

