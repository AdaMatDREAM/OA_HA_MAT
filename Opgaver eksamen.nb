Cell[TextData[{
 "Princippet om rekursion er, at man benytter sig af markov property, alts\
\[ARing] at man kun kigger p\[ARing] hvor man er, og hvad man skal \
g\[OSlash]re i denne situation, uden at tage h\[OSlash]jde for hvordan man er \
kommet til det punkt. Hvis vi har en guldk\[AE]de med l\[AE]ngde ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e26c349d-d5c3-254b-a7fc-c1eb350d60b9"],
 ", hvad er s\[ARing] den bedste m\[ARing]de at komme til dette punkt? Det \
bliver det centrale sp\[OSlash]rgsm\[ARing]l. Derefter sp\[OSlash]rger vi, \
givet at man har en k\[AE]de med l\[AE]ngden ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "-", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4140feb3-2f01-4d44-b9d3-2d9fb6225985"],
 ", hvad er s\[ARing] det optimale valg for at f\[ARing] en k\[AE]de med l\
\[AE]ngde ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d536f5d4-82c7-2a4c-8388-71d85c81f54f"],
 "? Derefter forts\[AE]tter man til ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "-", "2"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "548bf033-cd34-1841-bae3-e57c00978252"],
 " osv. indtil man ved hvad den optimale l\[OSlash]sning er. "
}], "Text",
 CellChangeTimes->{{3.9806787334326935`*^9, 3.9806787385611324`*^9}, {
  3.980678789434599*^9, 3.980678965093626*^9}, {3.9806791638028717`*^9, 
  3.980679252784334*^9}},ExpressionUUID->"a8f80564-53c6-3141-b5fc-\
ffca9c5f8d5f"],

Cell["Lad os pr\[OSlash]ve os ad med en l\[AE]ngde 9:", "Text",
 CellChangeTimes->{{3.9806792942421436`*^9, 
  3.9806793263438835`*^9}},ExpressionUUID->"6ce24ec2-9aca-8744-bb50-\
6144bd27dc21"]
}, Open  ]],

