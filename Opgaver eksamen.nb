 FormBox[GridBox[{
    {GridBox[{
       {
        RowBox[{
         SubscriptBox["x", 
          RowBox[{"i", " ", "j"}]], "=", 
         RowBox[{
         "Antal", " ", "gaver", " ", "som", " ", "sendes", " ", "fra", " ", 
          "i", " ", "til", " ", "j"}]}]}
      },
      GridBoxAlignment->{"Columns" -> {{"="}}}]}
   },
