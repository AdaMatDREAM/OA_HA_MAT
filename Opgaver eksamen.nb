Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {GridBox[{
       {
        RowBox[{
         RowBox[{
          SubscriptBox["x", "i"], "+", 
          SubscriptBox["i", 
           RowBox[{"t", "-", "1"}]]}], "=", 
         RowBox[{
          SubscriptBox["d", "i"], "+", 
          SubscriptBox["i", "t"]}]}]},
       {
        RowBox[{
         SubscriptBox["i", "0"], "=", 
         SubscriptBox["k", "1"]}]},
       {
        RowBox[{
         SubscriptBox["i", "k"], "=", 
         SubscriptBox["k", "2"]}]},
       {
        RowBox[{
         SubscriptBox["i", "t"], "<=", 
         SubscriptBox["k", "3"]}]}
      },
      GridBoxAlignment->{"Columns" -> {{"="}}}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
  TraditionalForm]],ExpressionUUID->"4336b7f2-016f-434a-8b28-12f90cf2f9cb"]], \
"Text",
 CellChangeTimes->{{3.9807419018486004`*^9, 3.9807419539310207`*^9}, {
  3.9807419929631042`*^9, 3.9807419972442856`*^9}, {3.9807421733437824`*^9, 
  3.980742179447607*^9}, {3.9807422095861816`*^9, 
  3.9807422231308537`*^9}},ExpressionUUID->"086b41cb-0df2-6847-ade7-\
a42870217c9c"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["k", "1"], "=", 
    RowBox[{
    "m\[AE]ngden", " ", "p\[ARing]", " ", "lager", " ", "i", 
     " ", "\"\<nulte\>\"", " ", "periode", " ", 
     RowBox[{"(", 
      RowBox[{"som", " ", "regel", " ", "nul"}], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "59a2f4a7-b934-da4c-baa1-43fef7399a1c"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["k", "2"], "=", " ", 
    RowBox[{
    "m\[AE]ngden", " ", "p\[ARing]", " ", "lager", " ", "i", " ", "sidste", " ", 
     RowBox[{"periode", "(", 
      RowBox[{"som", " ", "regel", " ", "nul"}], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "19092f73-a1b8-ad44-96e3-bf683889728e"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["k", "3"], "=", 
    RowBox[{"maksimal", " ", "lager", " ", "kapacitet"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b6a69d8f-c722-964a-bd45-69fb42b57ade"]
}], "Text",
