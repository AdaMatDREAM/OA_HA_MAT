Cell[CellGroupData[{

Cell["(a)", "Subsection",
 CellChangeTimes->{{3.9786141853011837`*^9, 
  3.9786141859369774`*^9}},ExpressionUUID->"873e67ae-e79f-9142-ae9a-\
9bd920bf3e25"],

Cell["\<\
Eftersom vi har med et maksimeringsproblem, bin\[AE]re varaible og kun en \
bibetingelse, kan vi se at vi har med et knapsack problem at g\[OSlash]re. \
\>", "Text",
 CellChangeTimes->{{3.978614187764059*^9, 
  3.9786142200635147`*^9}},ExpressionUUID->"df56f563-a890-c34f-a2e2-\
a189200a5c11"]
}, Open  ]],

Cell[CellGroupData[{

Cell["(b)", "Subsection",
 CellChangeTimes->{{3.978614224220068*^9, 
  3.9786142254464245`*^9}},ExpressionUUID->"d68803dc-8bf7-9e4e-9594-\
11b01bbf5133"],

Cell["\<\
Vi l\[OSlash]ser problemet med en gr\[ARing]dighedsalgoritme. Vi ser at de h\
\[OSlash]jeste koeefficienter er i denne r\[AE]kkef\[OSlash]lge\
\>", "Text",
 CellChangeTimes->{{3.978614263953823*^9, 3.9786142740654984`*^9}, {
  3.978614394071539*^9, 
  3.978614427074957*^9}},ExpressionUUID->"9929ecc9-c9a8-2046-b0f4-\
f2314689d035"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {GridBox[{
       {
        RowBox[{"1.", "->", 
         SubscriptBox["x", "5"]}]},
       {
        RowBox[{"2.", "->", 
         SubscriptBox["x", "4"]}]},
       {
        RowBox[{"3.", "->", 
         SubscriptBox["x", "3"]}]},
       {
        RowBox[{"4.", "->", 
         SubscriptBox["x", "1"]}]},
       {
        RowBox[{"5.", "->", 
         SubscriptBox["x", "2"]}]}
      },
      GridBoxAlignment->{"Columns" -> {{"="}}}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
  TraditionalForm]],ExpressionUUID->"d7b6a341-3972-ae40-bcd4-fff93a31ab1a"]], \
"Text",
 CellChangeTimes->{{3.9786144306077423`*^9, 3.9786144655119343`*^9}, {
  3.978614498287552*^9, 
  3.9786145043498287`*^9}},ExpressionUUID->"ed23550d-6b21-f541-b8b1-\
b427b9f5587a"],

Cell[TextData[{
 "Vi starter med at inkludere ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "5"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4bfe2d68-d6a3-0046-8c89-79d80b3a70a6"],
 " og derefter ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "4"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "26ac69ac-76a0-ee4a-abc1-6e4c447033ed"],
 " i vores basis. Da f\[ARing]r vi at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"7", "+", "6"}], "=", "13"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ee807df3-2313-a644-ba39-d8c9dc8ac0c1"],
 " og vi kan dermed kun inkludere ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4ad629be-8097-924d-9f84-0c4fce506319"],
 " uden at bruge bibetingelsen. Dermed bliver l\[OSlash]sningen ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "5"], "=", 
    RowBox[{
     SubscriptBox["x", "4"], "=", 
     RowBox[{
      SubscriptBox["x", "2"], "=", "1"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3d3c387b-cc6a-bf48-865b-5304a38e9e2c"],
 " imens alle andre variable er nul. Her bliver objektfunktionen ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"24", "+", "20", "+", "12"}], "=", "56"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1271d122-26c3-5347-bb26-6aaedf2a8239"],
 "."
}], "Text",
 CellChangeTimes->{{3.9786145077776356`*^9, 3.978614541275057*^9}, {
  3.978614575707882*^9, 3.9786146470688744`*^9}, {3.9786146862273464`*^9, 
  3.978614729127241*^9}},ExpressionUUID->"ba6e4db9-c03b-2d4f-b9bd-\
3b130e1322a7"]
}, Open  ]],

