  3.980661314338314*^9}},ExpressionUUID->"ca586550-3488-324e-a05e-\
ff2bb9b05233"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {GridBox[{
       {
        RowBox[{
         RowBox[{
          TemplateBox[<|"boxes" -> FormBox[
              UnderscriptBox["max", 
               RowBox[{
                 SubscriptBox[
                  StyleBox["x", "TI"], 
                  StyleBox["a", "TI"]], ",", 
                 SubscriptBox[
                  StyleBox["x", "TI"], 
                  StyleBox["b", "TI"]], ",", 
                 SubscriptBox[
                  StyleBox["x", "TI"], 
                  StyleBox["c", "TI"]], ",", 
                 StyleBox["y", "TI"]}], LimitsPositioning -> True], 
              TraditionalForm], "errors" -> {}, "input" -> 
            "\\max_{x_a,x_b,x_c,y}", "state" -> "Boxes"|>,
           "TeXAssistantTemplate"], "z"}], "=", 
         RowBox[{
          RowBox[{"4000", 
           SubscriptBox["x", "a"]}], "+", 
          RowBox[{"20", 
           SubscriptBox["x", "b"]}], "+", 
          RowBox[{"300", 
           SubscriptBox["x", "c"]}]}]}]}
      },
      GridBoxAlignment->{"Columns" -> {{"="}}}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
  TraditionalForm]],ExpressionUUID->"76d0ac37-876a-4443-8a61-fcd195746763"]], \
