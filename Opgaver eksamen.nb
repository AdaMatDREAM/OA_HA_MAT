Cell[CellGroupData[{

Cell["(a)", "Subsection",
 CellChangeTimes->{{3.978777672406807*^9, 
  3.9787776730825653`*^9}},ExpressionUUID->"e611aa55-d028-d84a-a681-\
9842b67642bb"],

Cell[TextData[{
 "Vi ser at eftersp\[OSlash]rgslen er ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"3", "+", "3", "+", "2", "+", "2"}], "=", "10"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "669c5390-639a-564c-93ba-bdce1c923355"],
 " og at udbud er ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"5", "+", "2", "+", "3"}], "=", "10"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "147129a9-e628-0d4a-906b-12af564387e4"],
 ", og dermed er transportalgoritmens antagelser opfyldt. "
}], "Text",
 CellChangeTimes->{{3.9787776785484924`*^9, 
  3.9787777272741833`*^9}},ExpressionUUID->"21ba3929-027d-e840-a209-\
ca49295d2aa6"]
}, Open  ]],

