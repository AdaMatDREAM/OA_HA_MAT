  3.980831767766039*^9}},ExpressionUUID->"b251c5b3-587b-2f40-8766-\
f97e87543522"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {GridBox[{
       {
        TagBox[GridBox[{
           {"Kommentar", 
            SubscriptBox["x", "s"], 
            SubscriptBox["x", "3"], 
            SubscriptBox["x", "x"], 
            RowBox[{"Begr\[AE]nsningn", " "}]},
           {
            RowBox[{
             RowBox[{
              RowBox[{
              "24", " ", "produktionsenheder", " ", "som", " ", "er", " ", 
               "tilg\[AE]ngelig", " ", "7", " ", "timer", " ", "i", " ", 
               "d\[OSlash]gnet"}], ",", 
              RowBox[{
               RowBox[{
               "og", " ", "en", " ", "samlet", " ", "produktionstid", " ", 
                "p\[ARing]", " ", "15", " ", 
                RowBox[{"dage", ".", "\[IndentingNewLine]", "Samlet"}], " ", 
                "produktiontid", " ", "tilg\[AE]ngelig", " ", "er", " ", 
                "dermed", " ", "24", "*", "7", "*", "15"}], "=", 
               RowBox[{"2520", " ", 
                RowBox[{"timer", ".", " ", 
                 SubscriptBox["x", "s"]}], " ", "har", " ", "produktionstid", 
                " ", "p\[ARing]", " ", "2.5"}]}]}], " ", "\[IndentingNewLine]", 
             RowBox[{"timer", ",", " ", 
              RowBox[{
               SubscriptBox["x", "3"], " ", "har", " ", "produktionstid", " ",
                "p\[ARing]", " ", "4.75", " ", "timer", " ", "og", " ", 
               SubscriptBox["x", "x"], " ", "har", " ", "produktionstid", " ",
                "p\[ARing]", " ", "1.25", " ", "timer", " "}]}]}], "2.5", 
            "4.75", "1.25", 
            RowBox[{"<=", "2520"}]},
           {
            RowBox[{
             RowBox[{"Maksimalt", " ", "865", " ", "kWh", " ", 
              RowBox[{"pr", ".", " ", "dag"}]}], ",", " ", 
             RowBox[{
              RowBox[{"svarende", " ", "til", " ", "15", "*", "865"}], "=", 
              RowBox[{"12975", " ", "kWh", " ", "i", " ", 
               RowBox[{"alt", "."}]}]}]}], "2.05", "1.87", "3.6", 
            RowBox[{"<=", "12975"}]},
           {
            RowBox[{
            "Vegansk", " ", "leder", " ", "betr\[AE]k", " ", "p\[ARing]", " ",
              "model", " ", "s", " ", "og", " ", "model", " ", "x", " ", 
             "m\[ARing]", " ", "maksimalt", " ", "v\[AE]re", " ", "25380", 
             SuperscriptBox["m", "2"]}], "2.4", " ", "4.8", 
            RowBox[{"<=", "25380"}]},
           {
            RowBox[{
             RowBox[{"Falcon", "-", 
              RowBox[{
              "m\[ARing]gewingd\[OSlash]r", " ", "maksimalt", " ", "antal", " ",
                "er", " ", "10542"}]}], ",", " ", 
             RowBox[{
             "og", " ", "kun", " ", "model", " ", "x", " ", "bruger", " ", 
              "to", " ", 
              RowBox[{"pr", ".", " ", "vil", " "}]}]}], " ", " ", "2", 
            RowBox[{"<=", "10542"}]},
           {
            RowBox[{
             RowBox[{
             "P\[ARing]", " ", "grund", " ", "af", " ", "kontraktlige", " ", 
              "betingelser", " ", "skal", " ", "salgsm\[AE]ngden", " ", "af", 
              " ", "Model", " ", "3", " ", "v\[AE]re", " ", "mindst", " ", 
              "6.371", " ", "og", " ", "m\[ARing]", " ", "ikke"}], "\n", 
             RowBox[{"overstige", " ", "7.500"}]}], " ", "1", " ", 
            RowBox[{"<=", "7500"}]},
           {
            RowBox[{
             RowBox[{"^", "___"}], "___", 
             RowBox[{"___", "^"}]}], " ", "1", " ", 
            RowBox[{">=", "6.371"}]}
          },
          GridBoxDividers->{"Columns" -> {{True}}, "Rows" -> {{True}}}],
         "Grid"]}
      },
      GridBoxAlignment->{"Columns" -> {{"Center"}}}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
  TraditionalForm]],ExpressionUUID->"b9de8013-f995-2a45-b5b0-89f8b1a83d7f"]], \
"Text",
 CellChangeTimes->{{3.9808308892408543`*^9, 3.980830931259943*^9}, {
  3.98083098531954*^9, 3.9808311848822517`*^9}, {3.9808312361122875`*^9, 
  3.980831329670477*^9}, {3.9808313668333244`*^9, 3.980831422729988*^9}, {
  3.980831453522295*^9, 3.98083170218318*^9}, {3.980831918235016*^9, 
