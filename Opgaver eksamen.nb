Cell[TextData[{
 "Vi ser at vi f\[ARing]r en optimal l\[OSlash]sning med ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["x", "1"], ",", 
      SubscriptBox["x", "2"], ",", 
      SubscriptBox["x", "3"], ",", 
      SubscriptBox["x", "4"], ",", 
      SubscriptBox["x", "5"]}], ")"}], "=", 
    RowBox[{"(", 
     RowBox[{"1", ",", "1", ",", "0", ",", "0.29", ",", "1"}], ")"}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6fb80f76-fd50-1b4b-aaa9-bd3ab6cb2332"],
 ". Eftersom alle koefficienter er positive, vores variable er heltal, og \
objektfunktionen antager v\[AE]rdien 56.71, ved vi at den optimale \
l\[OSlash]sning m\[ARing] have end objektfunktion med en v\[AE]rdi som er \
mindre end eller lig 56. Vi ser at hvis vi inkludere ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["s", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "19971908-dc10-3246-ab4e-966b0e585c70"],
 " i vores basis, vil objektfunktionen falde med netop 0.71 hvilket giver en \
v\[AE]rdi af objektfunktionen p\[ARing] 56. Hvis vi v\[AE]lger ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["s", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a4ade82d-2e11-0e47-9e1e-19d959128fc4"],
 " som vores pivot s\[OSlash]jle, kan vi enten erstatte denne med ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6b557250-0f8c-7040-8f54-db985147365e"],
 " eller ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["s", "5"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "add34937-753d-da40-beaf-a48064fa41fd"],
 ". Hvis vi v\[AE]lger ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4de08db6-757b-a74d-86dc-5c051eb98c08"],
 " ser vi at vi f\[ARing]r:"
}], "Text",
 CellChangeTimes->{{3.9786154374540234`*^9, 3.978615509764082*^9}, {
  3.9786155801536293`*^9, 3.9786156705619736`*^9}, {3.978615718474573*^9, 
  3.9786157655488663`*^9}, {3.978615965118986*^9, 3.978615993929043*^9}, {
  3.9786164509878693`*^9, 
  3.9786165250156116`*^9}},ExpressionUUID->"dc3ea751-501a-cc42-a4dc-\
02a1327917b1"],

