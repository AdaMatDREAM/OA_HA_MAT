Cell[CellGroupData[{

Cell["(d)", "Subsection",
 CellChangeTimes->{{3.977826142479389*^9, 
  3.9778261430891495`*^9}},ExpressionUUID->"bbb2013c-6cf4-c14d-8220-\
73475fce2f78"],

Cell[TextData[{
 "Vi ser at objektiv koefficienterne alle er negative, hvormed de vil \
v\[AE]re positive, liges\[ARing] snart de kommer ind tableauet, og det vil \
ligne at vi befinder os i en optimal l\[OSlash]sning med det samme. Derudover \
er ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0", ",", "0"}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fa15523e-b871-9c46-b218-08113bf2a1a3"],
 " ikke inkluderet som en BFS, og dermed vil vi starte vores algoritme uden \
for mulighedsomr\[ARing]det, hvilket ikke vil virke for simplex algoritmen. "
}], "Text",
 CellChangeTimes->{{3.977826035518448*^9, 
  3.977826134060198*^9}},ExpressionUUID->"0885370a-c2c5-704d-a8cf-\
802b02873727"]
}, Open  ]]
}, Closed]],

