Cell[TextData[{
 "Den bl\[ARing] linje er objektfunktionen. Vi kan se at maximum er ved en v\
\[AE]rdi af objektfunktionen p\[ARing] 31. \nHer sk\[AE]rer bibetingelsen ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"3", 
      SubscriptBox["x", "1"]}], "+", 
     SubscriptBox["x", "2"]}], "<=", "44"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cbc56bb3-d38f-0246-ad79-8e39e240fc6c"],
 " bibetingelsen ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["x", "1"], "+", 
     SubscriptBox["x", "2"]}], "<=", "18"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "13342c91-948f-414d-ab1f-589c287ff580"],
 " hinanden. Hvis vi vi l\[OSlash]ser ligningerne"
}], "Text",
