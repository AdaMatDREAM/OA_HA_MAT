                    TraditionalForm], "errors" -> {}, "input" -> 
                    "\\max_{x_{1f},x_{2f},x_{3f},x_{4f},x_{5f},x_{1a},x_{2a},\
x_{3a},x_{4a},x_{5a}}", "state" -> "Boxes"|>,
                   "TeXAssistantTemplate"], 
                  SubscriptBox["x", 
                   RowBox[{"1", "f"}]]}], "+", 
                 SubscriptBox["x", 
                  RowBox[{"2", "f"}]], "+", 
                 SubscriptBox["x", 
                  RowBox[{"3", "f"}]], "+", 
                 SubscriptBox["x", 
                  RowBox[{"4", "f"}]], "+", 
