Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {GridBox[{
       {
        RowBox[{
         RowBox[{"max", " ", "120", 
          SubscriptBox["x", "1"]}], "+", 
         RowBox[{"200", 
          SubscriptBox["x", "2"]}], "+", 
         RowBox[{"260", 
          SubscriptBox["x", "3"]}]}]},
       {
        RowBox[{"u", ".", "b", ".", "b"}]},
       {
        RowBox[{
         RowBox[{
          SubscriptBox["x", "1"], "+", 
          SubscriptBox["x", "2"], "+", 
          SubscriptBox["x", "3"]}], "<=", "11"}]},
       {
        RowBox[{
         RowBox[{
          RowBox[{"30", 
           SubscriptBox["x", "1"]}], "+", 
          RowBox[{"15", 
           SubscriptBox["x", "2"]}], "+", 
          RowBox[{"45", 
           SubscriptBox["x", "3"]}]}], "<=", "300"}]},
       {
        RowBox[{
         RowBox[{
          RowBox[{"40", 
           SubscriptBox["x", "1"]}], "+", 
          RowBox[{"80", 
           SubscriptBox["x", "2"]}], "+", 
          RowBox[{"120", 
           SubscriptBox["x", "3"]}]}], "<=", "820"}]},
       {
        RowBox[{
         SubscriptBox["x", "1"], ",", 
         SubscriptBox["x", "2"], ",", 
         RowBox[{
          SubscriptBox["x", "3"], ">=", "0"}]}]}
      },
      GridBoxAlignment->{"Columns" -> {{"Center"}}}]}
   },
