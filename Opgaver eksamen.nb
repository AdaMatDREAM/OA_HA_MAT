 FormBox[GridBox[{
    {GridBox[{
       {
        RowBox[{"\[Lambda]", "=", 
         RowBox[{
          RowBox[{
           FractionBox["1", "12"], "  ", "og", "  ", "\[Mu]"}], "=", 
          FractionBox["1", "8"]}]}]}
      },
      GridBoxAlignment->{"Columns" -> {{"Center"}}}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
