Cell[CellGroupData[{

Cell["a)", "Subsection",
 CellChangeTimes->{{3.9807739984312935`*^9, 
  3.9807739987789497`*^9}},ExpressionUUID->"7b5cc076-3e10-9b44-a6f7-\
f7c287b6d233"],

Cell["\<\
Kort informationsoversigt:
- 5 kurser
- 1 eller 2 eksamensperiode for alle kurser
- Kun eksamen 1 gang
- Fag 1 og 4 kan ikke tages i f\[OSlash]rste periode sammen
- Fag 2 og 3 skal afsluttes i samme periode
- Ikke mere end tre ekssamener pr. periode
- S\[ARing] mange som muligt i f\[OSlash]rste periode

Max vil gerne maksimerer antallet af eksamener, som han tager i \
f\[OSlash]rste periode. Dermed skal f\[AE]lgende maksimeres
\
\>", "Text",
 CellChangeTimes->{{3.9807740589669113`*^9, 3.9807742172524548`*^9}, {
  3.9807742490849304`*^9, 3.980774284450344*^9}, {3.980774485908123*^9, 
  3.9807744892591305`*^9}},ExpressionUUID->"a7ae8ff4-f399-9d41-b285-\
dbc09507e420"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {GridBox[{
       {
        RowBox[{
         RowBox[{
          TemplateBox[<|"boxes" -> FormBox[
              UnderscriptBox["max", 
               RowBox[{
                 SubscriptBox[
                  StyleBox["x", "TI"], 
                  RowBox[{"1", 
                    StyleBox["f", "TI"]}]], ",", 
                 SubscriptBox[
                  StyleBox["x", "TI"], 
                  RowBox[{"2", 
                    StyleBox["f", "TI"]}]], ",", 
                 SubscriptBox[
                  StyleBox["x", "TI"], 
                  RowBox[{"3", 
                    StyleBox["f", "TI"]}]], ",", 
                 SubscriptBox[
                  StyleBox["x", "TI"], 
                  RowBox[{"4", 
                    StyleBox["f", "TI"]}]], ",", 
                 SubscriptBox[
                  StyleBox["x", "TI"], 
                  RowBox[{"5", 
                    StyleBox["f", "TI"]}]], ",", 
                 SubscriptBox[
                  StyleBox["x", "TI"], 
                  RowBox[{"1", 
                    StyleBox["a", "TI"]}]], ",", 
                 SubscriptBox[
                  StyleBox["x", "TI"], 
                  RowBox[{"2", 
                    StyleBox["a", "TI"]}]], ",", 
                 SubscriptBox[
                  StyleBox["x", "TI"], 
                  RowBox[{"3", 
                    StyleBox["a", "TI"]}]], ",", 
                 SubscriptBox[
                  StyleBox["x", "TI"], 
                  RowBox[{"4", 
                    StyleBox["a", "TI"]}]], ",", 
                 SubscriptBox[
                  StyleBox["x", "TI"], 
                  RowBox[{"5", 
                    StyleBox["a", "TI"]}]]}], LimitsPositioning -> True], 
              TraditionalForm], "errors" -> {}, "input" -> 
            "\\max_{x_{1f},x_{2f},x_{3f},x_{4f},x_{5f},x_{1a},x_{2a},x_{3a},x_\
{4a},x_{5a}}", "state" -> "Boxes"|>,
           "TeXAssistantTemplate"], 
          SubscriptBox["x", 
           RowBox[{"1", "f"}]]}], "+", 
         SubscriptBox["x", 
          RowBox[{"2", "f"}]], "+", 
         SubscriptBox["x", 
          RowBox[{"3", "f"}]], "+", 
         SubscriptBox["x", 
          RowBox[{"4", "f"}]], "+", 
         SubscriptBox["x", 
          RowBox[{"5", "f"}]]}]}
      },
      GridBoxAlignment->{"Columns" -> {{"Center"}}}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
  TraditionalForm]],ExpressionUUID->"5ed07eef-61fc-ff4e-84b1-23b31be9b050"]], \
"Text",
 CellChangeTimes->{{3.9807742889038296`*^9, 3.980774291313513*^9}, {
  3.9807743283875847`*^9, 
  3.980774348552809*^9}},ExpressionUUID->"1b9f6022-b859-2e4d-9ebd-\
5cd952b0d53e"],

Cell["\<\
Han kan ikke tage en eksamen mere end en gang, og dermed f\[ARing]r vi f\
\[OSlash]lgende betingelser\
\>", "Text",
 CellChangeTimes->{{3.980774363305979*^9, 
  3.9807743767040443`*^9}},ExpressionUUID->"e8ba1b16-60ad-ae4b-a415-\
9b85e2788db4"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {GridBox[{
       {
        RowBox[{
         RowBox[{
          SubscriptBox["x", 
           RowBox[{"1", "f"}]], "+", 
          SubscriptBox["x", 
           RowBox[{"1", "a"}]]}], "<=", "1"}]},
       {
        RowBox[{
         RowBox[{
          SubscriptBox["x", 
           RowBox[{"2", "f"}]], "+", 
          SubscriptBox["x", 
           RowBox[{"2", "a"}]]}], "<=", "1"}]},
       {
        RowBox[{
         RowBox[{
          SubscriptBox["x", 
           RowBox[{"3", "f"}]], "+", 
          SubscriptBox["x", 
           RowBox[{"3", "a"}]]}], "<=", "1"}]},
       {
        RowBox[{
         RowBox[{
          SubscriptBox["x", 
