Cell[CellGroupData[{

Cell["a.", "Subsection",
 CellChangeTimes->{{3.9805917518268795`*^9, 
  3.980591752657345*^9}},ExpressionUUID->"343b794f-6214-4d4c-b863-\
e195bdb0a5bd"],

Cell[TextData[{
 "Der skal minimalt ans\[AE]ttes en person for at kunne servicerer kunderne, \
hvis hans antagelser holder. \nVi ved at ankomst raten er 4 i timen, og at \
den gennemsnitlige service tid er 12 minutter, hvormed service raten bliver ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"1", "/", 
     FractionBox["12", "60"]}], "=", "5"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8a564274-cafc-0a44-9ccc-7baf1073fba0"],
 " i timen. Dermed bliver utilisationen for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2c854486-c1ce-8841-9f76-f44c3388d760"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["4", "5"], "=", "0.8"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e5a4e385-3d1d-784a-9bca-689cec813aa0"],
 " og dermed skal der v\[AE]re mindst en person til stede for at servicerer \
kunderne. "
}], "Text",
 CellChangeTimes->{{3.980591754939823*^9, 3.9805917562887936`*^9}, {
  3.980591811201544*^9, 3.9805919511891384`*^9}, {3.980592004623518*^9, 
  3.980592050894726*^9}},ExpressionUUID->"4e0addd9-c98f-0546-bac9-\
9ea6863591d2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["b. ", "Subsection",
 CellChangeTimes->{{3.980592067263485*^9, 
  3.9805920679179363`*^9}},ExpressionUUID->"d8b97ee1-95d2-b749-885a-\
0ae39f3f8e38"],

