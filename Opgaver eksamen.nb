Cell["\<\
Dermed skal der v\[AE]re mindst 3 film for at utilisationer ikke er under 1. \
Hvis man har f\[AE]rre end tre, vil man ikke kunne betjene kunderne, og k\
\[OSlash]n bliver bare l\[AE]ngere og l\[AE]ngere\
\>", "Text",
 CellChangeTimes->{{3.980669040980156*^9, 3.9806690756037464`*^9}, {
  3.9806691238943806`*^9, 
  3.9806691327572002`*^9}},ExpressionUUID->"2dffa9cc-db80-2b4b-99b0-\
5a3ed63e2bde"],

Cell["\<\
De skal mindst eje tre. Her ses beregninger for dette tilf\[AE]lde\
\>", "Text",
 CellChangeTimes->{{3.980669164525934*^9, 
  3.980669176165283*^9}},ExpressionUUID->"5e9c2b5a-919e-e34a-bc8a-\
75f90c085366"],

