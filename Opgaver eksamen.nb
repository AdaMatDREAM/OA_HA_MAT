 RowBox[{"\[Rho]", ":=", 
  FractionBox["\[Lambda]", "\[Mu]"]}]], "Input",
 CellChangeTimes->{{3.980667738471922*^9, 3.980667752648901*^9}},
 CellLabel->"In[70]:=",ExpressionUUID->"7514e0ba-1df8-ad4d-826e-5e0c49a71353"],

Cell["\<\
Dermed bliver coefficient of variation for hhv. arrival og processing med \
udgangspunkt i standardafvigelserne\
\>", "Text",
 CellChangeTimes->{{3.9806678336497*^9, 3.980667870068466*^9}, 
   3.9806679281258163`*^9, {3.9806679959909916`*^9, 
   3.98066800745792*^9}},ExpressionUUID->"c3704db1-9507-e74c-99d1-\
aa3be874c51f"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      SubscriptBox["\[Sigma]", 
       SubscriptBox["T", "a"]], "=", 
      RowBox[{
       RowBox[{"3", "  ", "og", "  ", 
        SubscriptBox["\[Sigma]", 
         SubscriptBox["T", "p"]]}], "=", "6"}]}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
  TraditionalForm]],ExpressionUUID->"ad8f69ad-40c4-d948-a393-bd16b79dd95e"]], \
"Text",
 CellChangeTimes->{{3.980667872818388*^9, 
  3.9806679911875496`*^9}},ExpressionUUID->"d3575f76-e78b-444d-87fc-\
aa8babf4902a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Sigma]Ta", ":=", "3"}], ";", 
  RowBox[{"\[Sigma]Tp", ":=", "6"}], ";"}]], "Input",
 CellChangeTimes->{{3.980668131304743*^9, 3.980668146011238*^9}},
 CellLabel->"In[72]:=",ExpressionUUID->"0dacc81b-a03f-f74e-96ed-6c5125f47b6c"],

Cell["som giver", "Text",
 CellChangeTimes->{{3.9806680148344593`*^9, 
  3.980668015757601*^9}},ExpressionUUID->"e965c650-c141-0748-97ec-\
cb73ee670b8a"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{GridBox[{
         {
          RowBox[{
           SubscriptBox["c", "a"], "=", 
           RowBox[{
            RowBox[{
             SubscriptBox["\[Sigma]", 
              SubscriptBox["T", "a"]], "*", "\[Lambda]"}], "=", 
            RowBox[{
             RowBox[{"3", "*", 
              FractionBox["1", "12"]}], "=", 
             RowBox[{
              RowBox[{
               FractionBox["1", "4"], "  ", "og", "  ", 
               SubscriptBox["c", "p"]}], "=", 
              SubscriptBox["\[Sigma]", 
               SubscriptBox["T", "p"]]}]}]}]}]}
        },
        GridBoxAlignment->{"Columns" -> {{"Center"}}}], "*", "\[Mu]"}], "=", 
      RowBox[{
       RowBox[{"6", "*", 
        FractionBox["1", "8"]}], "=", 
       FractionBox["3", "4"]}]}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
  TraditionalForm]],ExpressionUUID->"5b8f8390-3443-894c-9254-231d7ad1d22d"]], \
"Text",
 CellChangeTimes->{{3.980668020275158*^9, 
  3.980668119443329*^9}},ExpressionUUID->"2ae67d20-7927-fc41-8365-\
09d7a789c3d8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ca", ":=", 
   RowBox[{"\[Sigma]Ta", "*", "\[Lambda]"}]}], ";", 
  RowBox[{"cp", ":=", 
   RowBox[{"\[Sigma]Tp", "*", "\[Mu]"}]}]}]], "Input",
 CellChangeTimes->{{3.980668245010418*^9, 3.9806682832878*^9}},
 CellLabel->"In[74]:=",ExpressionUUID->"75ae3e18-4871-c34e-928e-25038b86871a"],

Cell["Dermed bliver den gennemsnitlige tid i k\[OSlash]", "Text",
 CellChangeTimes->{{3.980668308520317*^9, 
  3.980668323861244*^9}},ExpressionUUID->"0038045e-30b0-c54d-bf2d-\
e74d102c0488"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {GridBox[{
       {
        RowBox[{
         RowBox[{"E", "(", 
          SubscriptBox["T", "q"], ")"}], ":=", 
         RowBox[{
          RowBox[{
           FractionBox[
            RowBox[{
             SuperscriptBox[
              SubscriptBox["c", "a"], "2"], "+", 
             SuperscriptBox[
              SubscriptBox["c", "p"], "2"]}], "2"], 
           FractionBox["\[Rho]", 
            RowBox[{"1", "-", "\[Rho]"}]], 
           FractionBox["1", "\[Mu]"]}], "=", 
          RowBox[{
           RowBox[{
            FractionBox[
             RowBox[{
              SuperscriptBox[
               RowBox[{"(", 
                FractionBox["1", "4"], ")"}], "2"], "+", 
              SuperscriptBox[
               RowBox[{"(", 
                FractionBox["3", "4"], ")"}], "2"]}], "2"], 
            FractionBox[
             FractionBox["2", "3"], 
             RowBox[{"1", "-", 
              FractionBox["2", "3"]}]], 
            FractionBox["1", 
             RowBox[{"1", "/", "8"}]]}], "=", "5"}]}]}]}
      },
      GridBoxAlignment->{"Columns" -> {{"Center"}}}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
  TraditionalForm]],ExpressionUUID->"bd04d924-5999-c943-afe0-59278f73f4f0"]], \
"Text",
 CellChangeTimes->{{3.9806684347975082`*^9, 3.9806684513927174`*^9}, {
  3.9806684960941143`*^9, 
  3.980668566510004*^9}},ExpressionUUID->"712300e2-3598-614c-8f65-\
fc84d8c2c7a1"],

Cell[BoxData[
 RowBox[{"ETq", ":=", 
  RowBox[{
   FractionBox[
    RowBox[{
     SuperscriptBox["ca", "2"], "+", 
     SuperscriptBox["cp", "2"]}], "2"], 
   FractionBox["\[Rho]", 
    RowBox[{"1", "-", "\[Rho]"}]], 
   FractionBox["1", "\[Mu]"]}]}]], "Input",
 CellChangeTimes->{{3.9806683714390125`*^9, 3.980668409620537*^9}},
 CellLabel->"In[77]:=",ExpressionUUID->"b395358b-2b3b-0c4f-8b17-d9d9322048e4"]
}, Open  ]],

