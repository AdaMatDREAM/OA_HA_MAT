  3.980602880336075*^9}},ExpressionUUID->"a3350dc7-ac91-0140-9196-\
28ea8e43b6c1"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {GridBox[{
       {
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", "NB", ")"}], 
           SubscriptBox["x", "a"]}], ">=", "0"}], ",", 
         RowBox[{
          SubscriptBox["x", "b"], ">=", "0"}], ",", 
         RowBox[{
          SubscriptBox["x", "c"], ">=", "0"}]}]}
      },
      GridBoxAlignment->{"Columns" -> {{"Center"}}}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
