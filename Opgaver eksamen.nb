Cell[TextData[{
 "Vi unders\[OSlash]ge hvilke af de to faciliteter som skal \[ARing]bnes. \
Eftersom vi kun kan v\[AE]lge mellem ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2847b788-6483-0e49-a248-14157d70b5f2"],
 " og ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "4"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "072f2e10-b5f6-c744-8686-19b5312e3bd2"],
 " og ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4a7b138f-5c2d-5d49-93a9-3d38c2bdebd2"],
 " giver en profit p\[ARing] 9, imens at ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "4"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "febe96ce-cde9-844d-b7ea-84909ddbc067"],
 " giver en profit p\[ARing] fire, skal ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "88394b14-0c56-3345-aa1b-7e83946e4596"],
 " \[ARing]bnes. Dermed bliver l\[OSlash]sningen ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["x", "1"], ",", 
      SubscriptBox["x", "2"], ",", 
      SubscriptBox["x", "3"], ",", 
      SubscriptBox["x", "4"]}], ")"}], "=", 
    RowBox[{"(", 
     RowBox[{"1", ",", "1", ",", "0", ",", "0"}], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "51143635-0469-2f4e-9458-de1a6ff279f2"],
 ". Her bliver profitten ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"9", "+", "5"}], "=", 
    RowBox[{"14", " ", 
     RowBox[{"mio", ".", " ", "kr", "."}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a2ea3803-aa27-6c4a-9cbe-228cb48716eb"],
 " Det kommer til at koste ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"6", "+", "3"}], "=", 
    RowBox[{"9", " ", 
     RowBox[{"mio", ".", " ", "kr", ".", " "}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "86216d84-0f0c-354f-b382-a82752a2fabf"]
}], "Text",
 CellChangeTimes->{{3.9784527473036137`*^9, 
  3.978452902365244*^9}},ExpressionUUID->"bd5e8ed3-b5bb-b842-be5a-\
b8cf4d2995a2"]
}, Open  ]],

