 FormBox[GridBox[{
    {GridBox[{
       {
        RowBox[{
         SubscriptBox["\[Sigma]", 
          SubscriptBox["T", "a"]], "=", 
         RowBox[{"0.01", " ", "timer"}]}]},
       {
        RowBox[{
         SubscriptBox["\[Sigma]", 
          SubscriptBox["T", "p"]], "=", 
         RowBox[{"0.05", " ", "timer"}]}]}
      },
      GridBoxAlignment->{"Columns" -> {{"Center"}}}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
