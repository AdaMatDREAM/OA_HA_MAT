  3.978617928219412*^9}},ExpressionUUID->"a3dd9382-9190-7e48-8fc5-\
b73beaef6290"],

Cell["Vi runder ned til n\[AE]rmeste heltal", "Text",
 CellChangeTimes->{{3.9786179312331753`*^9, 
  3.978617937347208*^9}},ExpressionUUID->"8070b3d8-8e69-184a-8559-\
a59e84d5db24"],

