}, Open  ]],

Cell[TextData[{
 "dermed 10. Vi f\[ARing]r f\[OSlash]lgende interval ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"[", 
     RowBox[{
      RowBox[{"40", "-", "10"}], ";", 
      RowBox[{"40", "+", "30"}]}], "]"}], " ", "=", " ", 
