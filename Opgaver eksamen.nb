 CellChangeTimes->{{3.980661009345541*^9, 
  3.980661043172079*^9}},ExpressionUUID->"e06ccc4f-05fb-814b-baf7-\
fc3e7b6b531a"],

Cell[TextData[{
 "Nu mangler vi bare en betingelse, som sikrer, at hvis ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "a"], ">", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "98609d73-9bef-564e-93c4-681cdaac8ef2"],
 " s\[ARing] er ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7934d383-5490-7f42-a74c-d08328d299e5"],
 " og hvis ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "a"], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "41236408-27e3-b74a-9aa8-c77fb303efc1"],
 " s\[ARing] er ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", ">", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f0e441b3-22ec-ac40-abfa-c149d81a5e83"],
 ". Denne kunne se s\[ARing]ledes ud"
}], "Text",
 CellChangeTimes->{{3.980661067500477*^9, 
  3.980661136229782*^9}},ExpressionUUID->"e101306f-893b-b247-b99e-\
592012130ad4"],

