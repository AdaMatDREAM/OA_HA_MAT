Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {GridBox[{
       {
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", "Pris", ")"}], "  ", "100000", 
           SubscriptBox["x", "a"]}], "+", 
          RowBox[{"5000", 
           SubscriptBox["x", "b"]}], "+", 
          RowBox[{"15000", 
           SubscriptBox["x", "c"]}]}], "<=", 
         RowBox[{"800000", "+", 
          RowBox[{"120000", "y"}]}]}]},
       {
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", "Pris", ")"}], "  ", "100000", 
           SubscriptBox["x", "a"]}], "+", 
          RowBox[{"5000", 
           SubscriptBox["x", "b"]}], "+", 
          RowBox[{"15000", 
           SubscriptBox["x", "c"]}], "-", 
          RowBox[{"120000", "y"}]}], "<=", "800000"}]}
      },
      GridBoxAlignment->{"Columns" -> {{"Center"}}}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
  TraditionalForm]],ExpressionUUID->"0e328c0c-3bea-9a40-9411-06d78fb33a06"]], \
