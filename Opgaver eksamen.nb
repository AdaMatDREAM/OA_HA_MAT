 CellLabel->"Out[8]=",ExpressionUUID->"5d9057b2-ab6c-5441-9e76-aaa1a53842e3"]
}, Open  ]],

Cell["\<\
30, som er minimum af ovenst\[ARing]ende ratios. Det maksimale fald bliver\
\>", "Text",
 CellChangeTimes->{{3.9784360691075497`*^9, 
  3.978436083828514*^9}},ExpressionUUID->"3dc6d4cb-4d19-514f-a375-\
8da3af39017e"],

