Cell[TextData[{
 "Betingelsen ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "4"], "<=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "622d754c-9d6e-9c4c-9cce-331bab25d6e1"],
 " vil altid v\[AE]re opfyldt og denne kan ogs\[ARing] smides v\[AE]k.  \
Desuden er betingelserne ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"6", 
      SubscriptBox["x", "1"]}], "+", 
     RowBox[{"2", 
      SubscriptBox["x", "4"]}]}], "<=", "7"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3a1cce52-f9ac-b94d-87b4-94fded44807c"],
 " og ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["x", "1"], "+", 
     SubscriptBox["x", "4"]}], "<=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3f6fccac-3c37-ed41-a69c-5aea83d805e0"],
 " \[AE]kvivalente i vores sammenh\[AE]ng, og dermed kan jeg smide en af \
disse v\[AE]k. Da bliver problemet"
}], "Text",
 CellChangeTimes->{{3.9784525891091576`*^9, 
  3.978452659486454*^9}},ExpressionUUID->"d54b5db6-7fef-0b40-9702-\
144dcb7f3380"],

