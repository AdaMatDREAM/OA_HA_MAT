 CellChangeTimes->{{3.980667569999464*^9, 
  3.980667587384489*^9}},ExpressionUUID->"7b986c18-3c1f-3944-942f-\
23edc0f45472"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Lambda]", ":=", 
   FractionBox["1", "12"]}], ";", 
  RowBox[{"\[Mu]", ":=", 
   FractionBox["1", "8"]}], ";"}]], "Input",
 CellChangeTimes->{{3.980667721144823*^9, 3.980667731344612*^9}},
 CellLabel->"In[69]:=",ExpressionUUID->"7b1782d2-547d-f840-9656-063e7a265ad7"],

Cell["Dermed bliver utilization", "Text",
