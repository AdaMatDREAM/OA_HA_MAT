Cell[TextData[{
 "Hvor ",
 Cell[BoxData[
  FormBox["L", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6bc57fb4-b201-ef46-8a9e-5405dec95de8"],
 " er et stort tal. Dermed f\[ARing]r vi f\[OSlash]lgende system"
}], "Text",
