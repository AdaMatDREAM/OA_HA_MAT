Cell["\<\
Dette er et eksempel p\[ARing] minimum spanning tree problemet, da alle noder \
skal sammens\[AE]ttes med edges til den laveste mulige omkostning.\
\>", "Text",
 CellChangeTimes->{{3.978872648090458*^9, 
  3.978872687272255*^9}},ExpressionUUID->"924d345b-1917-6942-9b95-\
e509e17fd35e"],

Cell["\<\
Vi l\[OSlash]ser problemet med kruskals algoritme. Vi opstiller alle edges \
fra mindst til h\[OSlash]jest og benytter algoritmen\
\>", "Text",
 CellChangeTimes->{{3.9789418557175503`*^9, 3.9789418948659687`*^9}, {
  3.9789423075607243`*^9, 
  3.9789423110058804`*^9}},ExpressionUUID->"6054b5cc-0478-d248-8730-\
dad8e2d8b532"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {GridBox[{
       {
        TagBox[GridBox[{
           {
            RowBox[{"Node", " ", "1"}], 
            RowBox[{"Node", " ", "2"}], "V\[AE]gt", "Inkluderet"},
           {"B", "C", "1", "ja"},
           {"A", "B", "2", "ja"},
           {"E", "H", "2", "ja"},
           {"D", "C", "3", "ja"},
           {"C", "E", "3", "ja"},
           {"F", "H", "3", "ja"},
           {"A", "C", "4", "nej"},
           {"B", "E", "4", "nej"},
           {"C", "F", "4", "nej"},
           {"G", "H", "4", "ja"},
           {"A", "D", "5", "nej"},
           {"A", "E", "5", "nej"},
           {"C", "F", "5", "nej"},
           {"G", "F", "5", "nej"},
           {"D", "G", "6", "nej"},
           {"D", "H", "7", "nej"}
