Cell[CellGroupData[{

Cell["(a)", "Subsection",
 CellChangeTimes->{{3.9784501928053017`*^9, 
  3.978450193177805*^9}},ExpressionUUID->"430aad32-5487-d343-a6e7-\
36b10006a56f"],

Cell[TextData[{
 "Vi definerer fire beslutningsvariable, en for hver facilitet: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "1"], ",", 
    SubscriptBox["x", "2"], ",", 
    RowBox[{
     SubscriptBox["x", "3"], " ", "og", " ", 
     SubscriptBox["x", "4"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "df039d33-98f0-e846-812b-06babc09ef83"],
 ".\nVi ved, at der kun kan \[ARing]bnes en af hver facilitet, hvilket \
betyder at alle beslutningsariable er bin\[AE]re: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "1"], ",", 
    SubscriptBox["x", "2"], ",", 
    SubscriptBox["x", "3"], ",", 
    RowBox[{
     SubscriptBox["x", "4"], "\[Element]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "1"}], "}"}], "."}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "740e4722-14a7-3d45-afd8-817bae22cb3f"],
 "\nVirksomheden vil \[ARing]bne maks fire faciliteter: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["x", "1"], "+", 
     SubscriptBox["x", "2"], "+", 
     SubscriptBox["x", "3"], "+", 
     SubscriptBox["x", "4"]}], "<=", "4"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "10297723-c950-854a-aad5-73b3450c7745"],
 ".\nProfitten er hhv. 9, 5, 6 og 4 mio. kr. hvilket giver \
objektivfunktionen: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"z", "=", 
    RowBox[{
     RowBox[{"9", 
      SubscriptBox["x", "1"]}], "+", 
     RowBox[{"5", 
      SubscriptBox["x", "2"]}], "+", 
     RowBox[{"6", 
      SubscriptBox["x", "3"]}], "+", 
     RowBox[{"4", 
      SubscriptBox["x", "4"]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fc60e0cb-e193-dc4f-9d80-b35a5bb343e9"],
 ".\nSamlet budget er 10 mio. kr. og det koster hhv. 6, 3, 5, 2 at \
\[ARing]bne de forskellige faciliteter: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"6", 
      SubscriptBox["x", "1"]}], "+", 
     RowBox[{"3", 
      SubscriptBox["x", "2"]}], "+", 
     RowBox[{"5", 
      SubscriptBox["x", "3"]}], "+", 
     RowBox[{"2", 
      SubscriptBox["x", "4"]}]}], "<=", "10"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9a73ba72-6f1f-9d47-96a9-df3a0630615b"],
 ".\nMaksimal forurening er 200 kg, og der forurenes allerede 43 kg. \
Faciliteterne forurener hhv. 46, 37, 34 og 38 kg, hvilket giver betingelsen: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"46", 
      SubscriptBox["x", "1"]}], "+", 
     RowBox[{"37", 
      SubscriptBox["x", "2"]}], "+", 
     RowBox[{"34", 
      SubscriptBox["x", "3"]}], "+", 
     RowBox[{"38", 
      SubscriptBox["x", "4"]}]}], "<=", "157"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7a5c9e4a-c295-6944-a5bf-01df8b92c29b"],
 ".\nKun en af faciliteterne 1 og 4 m\[ARing] \[ARing]bnes: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["x", "1"], "+", 
     SubscriptBox["x", "4"]}], "<=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d487d958-480f-0b45-9311-e91b95b182c1"],
 ".\nFacilitet 3 kan kun \[ARing]bnes, hvis facilitet 1 ogs\[ARing] \
\[ARing]bnes: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["x", "3"], "-", 
     SubscriptBox["x", "1"]}], "<=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9c3d6ed2-b6a4-504d-abe9-1017abea1a89"],
 ".\nFacilitet 4 kan kun \[ARing]bnes, hvis facilitet 2 ogs\[ARing] \
\[ARing]bnes: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["x", "4"], "-", 
     SubscriptBox["x", "2"]}], "<=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6858d2d0-0648-664f-8667-6304ccfef3d2"],
 ".\n\nDermed f\[ARing]s f\[OSlash]lgende program (P)"
}], "Text",
 CellChangeTimes->{{3.978450263893366*^9, 
  3.978450898894951*^9}},ExpressionUUID->"4e172fc5-6549-994d-8631-\
d24d71c6be77"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {GridBox[{
       {
        RowBox[{
         RowBox[{"Max", " ", "z"}], "=", 
         RowBox[{
          RowBox[{"9", 
           SubscriptBox["x", "1"]}], "+", 
          RowBox[{"5", 
           SubscriptBox["x", "2"]}], "+", 
          RowBox[{"6", 
           SubscriptBox["x", "3"]}], "+", 
          RowBox[{"4", 
           SubscriptBox["x", "4"], " "}]}]}]},
       {
        RowBox[{"u", ".", "b", ".", "b", "."}]},
       {
        RowBox[{
         RowBox[{
          SubscriptBox["x", "1"], "+", 
          SubscriptBox["x", "2"], "+", 
          SubscriptBox["x", "3"], "+", 
          SubscriptBox["x", "4"]}], "<=", "4"}]},
       {
        RowBox[{
         RowBox[{
          RowBox[{"6", 
           SubscriptBox["x", "1"]}], "+", 
          RowBox[{"3", 
           SubscriptBox["x", "2"]}], "+", 
          RowBox[{"5", 
           SubscriptBox["x", "3"]}], "+", 
          RowBox[{"2", 
           SubscriptBox["x", "4"]}]}], "<=", "10"}]},
       {
        RowBox[{
         RowBox[{
          RowBox[{"46", 
           SubscriptBox["x", "1"]}], "+", 
          RowBox[{"37", 
           SubscriptBox["x", "2"]}], "+", 
          RowBox[{"34", 
           SubscriptBox["x", "3"]}], "+", 
          RowBox[{"38", 
           SubscriptBox["x", "4"]}]}], "<=", "157"}]},
       {
        RowBox[{
         RowBox[{
          SubscriptBox["x", "1"], "+", 
          SubscriptBox["x", "4"]}], "<=", "1"}]},
       {
        RowBox[{
         RowBox[{
          SubscriptBox["x", "3"], "-", 
          SubscriptBox["x", "1"]}], "<=", "0"}]},
       {
        RowBox[{
         RowBox[{
          SubscriptBox["x", "4"], "-", 
          SubscriptBox["x", "2"]}], "<=", "0"}]},
       {
        RowBox[{
         SubscriptBox["x", "1"], ",", 
         SubscriptBox["x", "2"], ",", 
         SubscriptBox["x", "3"], ",", 
         RowBox[{
          SubscriptBox["x", "4"], "\[Element]", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}]}]}]}
      },
      GridBoxAlignment->{"Columns" -> {{"Center"}}}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
  TraditionalForm]],ExpressionUUID->"c888e1ed-f455-f548-98ad-f1eb4799eaa1"]], \
"Text",
 CellChangeTimes->{{3.9784508933838997`*^9, 
  3.97845099722027*^9}},ExpressionUUID->"b9a5f8d8-280e-0040-baa9-\
a72d1ac5b615"]
}, Open  ]],

Cell[CellGroupData[{

Cell["(b)", "Subsection",
 CellChangeTimes->{{3.9784510485954475`*^9, 
  3.9784510490315247`*^9}},ExpressionUUID->"63f9e436-8d0e-a54a-a10e-\
4d8359a2fee1"],

Cell[TextData[{
 "Vi ved at beslutningsvariablene er bin\[AE]re, og dermed vil betingelsen ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["x", "1"], "+", 
     SubscriptBox["x", "2"], "+", 
     SubscriptBox["x", "3"], "+", 
     SubscriptBox["x", "4"]}], "<=", "4"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "dbf96890-c68d-3242-a2cd-3f1bd92eb8dd"],
 " altid v\[AE]re opfyldt. Desuden bliver betingelsen ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"46", 
      SubscriptBox["x", "1"]}], "+", 
     RowBox[{"37", 
      SubscriptBox["x", "2"]}], "+", 
     RowBox[{"34", 
      SubscriptBox["x", "3"]}], "+", 
     RowBox[{"38", 
      SubscriptBox["x", "4"]}]}], "<=", "157"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0d85f969-464f-5e41-bfac-d1d13e76be9c"],
 " ogs\[ARing] overfl\[OSlash]dig, da betingelsen altid er opfyldt. Vi ser at \
hvis ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "3"], "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "00ff7c7a-2c9a-fa4d-b7ce-402da6ba7d6a"],
 " s\[ARing] skal ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "1"], "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "50215cc1-8482-624a-be2d-0348ff5d177c"],
 " men da bliver forureningbetingelsen brudt, og dermed skal ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "3"], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "67b546b5-7005-834d-8423-acc456b59c9d"],
 ". Denne variabel bliver alts\[ARing] overfl\[OSlash]dig, da den altid skal \
v\[AE]re nul. Da f\[ARing]r vi fra ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["x", "3"], "-", 
      SubscriptBox["x", "1"]}], "<=", "0"}], "->", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       SubscriptBox["x", "1"]}], "<=", "0"}], "->", 
     RowBox[{
      SubscriptBox["x", "1"], ">=", "0"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "26e956d3-4e01-394f-a038-0c900fe0ce41"],
 ", men eftersom ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "1"], "\[Element]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "1"}], "}"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0bb02d03-e649-7c40-b2d4-44f9c2c8c2ac"],
 " vil denne ogs\[ARing] altid v\[AE]re opfyldt, og dermed kan vi ogs\[ARing] \
smide denne bibetingelse v\[AE]k.\nDa f\[ARing]r vi f\[OSlash]lgende program:"
}], "Text",
 CellChangeTimes->{{3.9784510509307537`*^9, 3.9784510724677773`*^9}, {
  3.9784511347219963`*^9, 3.978451189995428*^9}, {3.9784512618670845`*^9, 
  3.9784512734987106`*^9}, {3.9784515694624233`*^9, 3.978451570303108*^9}, {
  3.978451601170309*^9, 3.9784517490104504`*^9}, {3.9784518702447586`*^9, 
  3.9784518712932568`*^9}},ExpressionUUID->"7e0ef841-ff16-b24f-b241-\
fb6e89687cb8"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {GridBox[{
       {
        RowBox[{
         RowBox[{"Max", " ", "z"}], "=", 
         RowBox[{
          RowBox[{"9", 
           SubscriptBox["x", "1"]}], "+", 
          RowBox[{"5", 
           SubscriptBox["x", "2"]}], "+", 
          RowBox[{"4", 
           SubscriptBox["x", "4"], " "}]}]}]},
       {
        RowBox[{"u", ".", "b", ".", "b", "."}]},
       {
        RowBox[{
         RowBox[{
          RowBox[{"6", 
           SubscriptBox["x", "1"]}], "+", 
          RowBox[{"3", 
           SubscriptBox["x", "2"]}], "+", 
          RowBox[{"2", 
           SubscriptBox["x", "4"]}]}], "<=", "10"}]},
       {
        RowBox[{
         RowBox[{
          SubscriptBox["x", "1"], "+", 
          SubscriptBox["x", "4"]}], "<=", "1"}]},
       {
        RowBox[{
         RowBox[{
          SubscriptBox["x", "4"], "-", 
          SubscriptBox["x", "2"]}], "<=", "0"}]},
       {
        RowBox[{
         SubscriptBox["x", "1"], ",", 
         SubscriptBox["x", "2"], ",", 
         RowBox[{
          SubscriptBox["x", "4"], "\[Element]", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}]}]}]}
      },
      GridBoxAlignment->{"Columns" -> {{"Center"}}}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
  TraditionalForm]],ExpressionUUID->"552a6791-e179-3f42-9ef5-5cae40f1476e"]], \
"Text",
 CellChangeTimes->{{3.9784508933838997`*^9, 3.97845099722027*^9}, {
  3.9784512039514046`*^9, 3.9784512109693813`*^9}, {3.9784516580535736`*^9, 
