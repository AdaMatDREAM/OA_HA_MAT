Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"u1", "+", "v1"}], "==", "3"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"u1", "+", "v2"}], "==", "7"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"u1", "+", "v3"}], "==", "6"}], ",", "\[IndentingNewLine]", 
