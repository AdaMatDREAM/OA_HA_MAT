Cell[TextData[{
 "Vi ser at der er en optimal l\[OSlash]sning n\[ARing]r ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["x", "1"], ",", 
      SubscriptBox["x", "2"], ",", 
      SubscriptBox["x", "3"]}], ")"}], "=", 
    RowBox[{"(", 
     RowBox[{"1", ",", "1", ",", "0"}], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "eb4fa1db-43f7-a946-82ed-e2aea0b031ba"],
 " og her bliver v\[AE]rdien af objektivfunktionen 102. Vi bem\[AE]rker at ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "dac4da04-11cc-6d4c-834d-0bc0eeed4c2d"],
 " ikke er med i basis, men at den har reduced cost lig 0 (se i z \
r\[AE]kken). Det betyder at vi kan indrage denne i vores basis, uden at \
\[AE]ndre p\[ARing] objektivfunktionens v\[AE]rdi, og der m\[ARing] alts\
\[ARing] v\[AE]re flere l\[OSlash]sning. Eksempelvis kan vi lave en basis med \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f9ddd9ab-b427-194a-b564-820e43bdb3b7"],
 " og ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "aeb256f1-61e7-ce48-9efe-9a08939910b7"],
 " i stedet og f\[ARing] nedenst\[ARing]ende l\[OSlash]sningstableau"
}], "Text",
 CellChangeTimes->{{3.978433746550194*^9, 3.9784338742463017`*^9}, {
  3.978434112939705*^9, 
  3.978434144507221*^9}},ExpressionUUID->"0d209d25-0f6c-474e-af98-\
5d8cfa865850"],

