Cell[TextData[{
 "Vi ser at der ingen negative v\[AE]rdier er i f\[OSlash]rste r\[AE]kke, som \
skulle v\[AE]re den nye pivot r\[AE]kke, og dermed har problemet ingen l\
\[OSlash]sning. Dette skyldes at der mindst skal produceres 6371 enheder af ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6fefab1e-6ac2-1941-bfd5-03b84dbfc0bb"],
 " samtidigt med at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"4.75", 
     SubscriptBox["x", "3"]}], "<=", "2520"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "964ab72a-b678-d84d-9b9a-dd3ef681c2cd"],
 ", hvormed der ingen l\[OSlash]sning er. "
}], "Text",
 CellChangeTimes->{{3.9808349706850014`*^9, 3.980834988852682*^9}, {
  3.980835031804962*^9, 
  3.980835089029339*^9}},ExpressionUUID->"88d21adb-b9cc-f346-9b30-\
0d336f37f7e5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["c)", "Subsection",
 CellChangeTimes->{{3.980835094763567*^9, 
  3.9808350951422825`*^9}},ExpressionUUID->"8b1e05a6-9ac5-ab42-9451-\
53fb0e678822"],

Cell["Problemet har som sagt ingen l\[OSlash]sning. ", "Text",
 CellChangeTimes->{{3.9808350966408157`*^9, 
  3.980835101061678*^9}},ExpressionUUID->"d8ab1246-fea3-c442-ade4-\
c5ec6929da2b"]
}, Open  ]]
}, Open  ]],

