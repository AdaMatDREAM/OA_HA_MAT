 FormBox[GridBox[{
    {GridBox[{
       {
        RowBox[{
         RowBox[{
          SubscriptBox["x", "1"], "-", 
          SubscriptBox["x", "3"], "+", 
          RowBox[{"2", 
           SubscriptBox["s", "1"]}], "-", 
          RowBox[{"0", 
           SubscriptBox["s", "3"]}]}], "=", "1"}]}
      },
