Cell["\<\
Der kan sendes et vist antal gaver igennem hver edge i ovenst\[ARing]ende, og \
dette bliver vores beslutningsvariable. Dermed har vi at\
\>", "Text",
 CellChangeTimes->{{3.980839321204729*^9, 
  3.980839406317892*^9}},ExpressionUUID->"a2e663cb-fff0-6149-ba83-\
a12f8314d4ee"],

