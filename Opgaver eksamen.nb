Cell[TextData[{
 "Derefter v\[AE]lger vi en besisr\[AE]kke, som ikke indeholder en slack \
variabel. Vi v\[AE]lger den f\[OSlash]rste r\[AE]kke, den med ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b45b436a-2f0e-5e48-9378-e57e6cd59d6c"],
 ". Da f\[ARing]r vi f\[OSlash]lgende ligning som vi derefter runder ned til \
n\[AE]rmeste heltallige koefficienter"
}], "Text",
 CellChangeTimes->{{3.9785936635798016`*^9, 
  3.978593734302801*^9}},ExpressionUUID->"52809534-9e58-4948-aada-\
2f4d945c4bf6"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {GridBox[{
       {
        RowBox[{
         RowBox[{
          SubscriptBox["x", "1"], "+", 
          RowBox[{"0.08", 
           SubscriptBox["s", "1"]}], "+", 
          RowBox[{"0.08", 
           SubscriptBox["s", "3"]}]}], "=", "2.92"}]},
       {
        RowBox[{
         SubscriptBox["x", "1"], "=", "2"}]}
      },
      GridBoxAlignment->{"Columns" -> {{"="}}}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
  TraditionalForm]],ExpressionUUID->"4420c2f0-1d59-784d-ae70-910be1b7cd1a"]], \
"Text",
 CellChangeTimes->{{3.978593737664253*^9, 
  3.9785937954293404`*^9}},ExpressionUUID->"6884a4e3-180a-ae4b-8913-\
2a2974d9c0fe"],

Cell[TextData[{
 "Hvilket giver begr\[AE]nsningen ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "1"], "<=", "2"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2936c783-5360-1e42-8f06-1cb84f83868d"],
 ". Vi tr\[AE]kker den nedrundede ligning fra den originale"
}], "Text",
 CellChangeTimes->{{3.9785937999477673`*^9, 
  3.978593837849495*^9}},ExpressionUUID->"01d3eb3f-8707-d24a-9041-\
c32dcbc96e11"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{
       SubscriptBox["x", "1"], "+", 
       RowBox[{"0", 
        SubscriptBox["s", "1"]}], "+", 
       RowBox[{"0", 
        SubscriptBox["s", "2"]}]}], "=", "2"}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["x", "1"], "+", 
       RowBox[{"0.08", 
        SubscriptBox["s", "1"]}], "+", 
       RowBox[{"0.08", 
        SubscriptBox["s", "3"]}]}], "=", "2.92"}]},
    {
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", "0.08"}], 
        SubscriptBox["s", "1"]}], "-", 
       RowBox[{"0.08", 
        SubscriptBox["s", "3"]}]}], "=", 
      RowBox[{"-", "0.92"}]}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
  TraditionalForm]],ExpressionUUID->"3d20b29c-cec8-484b-89da-53f95c4fe5e6"]], \
"Text",
 CellChangeTimes->{{3.978593841909334*^9, 3.9785938851279335`*^9}, {
  3.978594059954588*^9, 
  3.9785940784497128`*^9}},ExpressionUUID->"935530ee-4457-7049-8bbc-\
72f728e4a7ab"],

Cell[TextData[{
 "Vi tilf\[OSlash]jer endnu en slackvariabel ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["s", "4"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cb2d2387-ca3a-d049-af75-802952e1ab0b"],
 " og f\[ARing]r ligningen"
}], "Text",
 CellChangeTimes->{{3.97859415145286*^9, 3.978594156748625*^9}, {
  3.9785943517920914`*^9, 
  3.9785943666624947`*^9}},ExpressionUUID->"2ae45710-123b-3b40-8496-\
36808d6b6a8a"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {GridBox[{
       {
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"-", "0.08"}], 
           SubscriptBox["s", "1"]}], "-", 
          RowBox[{"0.08", 
           SubscriptBox["s", "3"]}], "+", 
          SubscriptBox["s", "4"]}], "=", 
         RowBox[{"-", "0.92"}]}]}
      },
      GridBoxAlignment->{"Columns" -> {{"Center"}}}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
  TraditionalForm]],ExpressionUUID->"50dac10c-80ef-8440-ac1a-eec86a718c47"]], \
"Text",
 CellChangeTimes->{{3.9785943696923866`*^9, 
  3.97859437816724*^9}},ExpressionUUID->"306cb6a2-984d-df47-8f84-\
26ce0fb39484"],

