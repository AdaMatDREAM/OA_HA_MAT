Cell[BoxData[""], "Input",
 CellChangeTimes->{{3.980589764222311*^9, 
  3.9805897651036987`*^9}},ExpressionUUID->"49f4b673-e188-664d-8892-\
7cf16dec5949"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {GridBox[{
       {
        RowBox[{
         SubscriptBox["c", "a"], "=", 
         RowBox[{
          FractionBox[
           SubscriptBox["\[Sigma]", 
            SubscriptBox["T", "a"]], 
           RowBox[{"E", "(", 
            SubscriptBox["T", "a"], ")"}]], "=", 
          RowBox[{
           FractionBox[
            SubscriptBox["\[Sigma]", 
             SubscriptBox["T", "a"]], 
            RowBox[{"1", "/", "\[Lambda]"}]], "=", 
           RowBox[{
            FractionBox["0.01", 
             RowBox[{"1", "/", "60"}]], "=", 
            RowBox[{
             FractionBox["3", "5"], "=", "0.6"}]}]}]}]}]},
       {
        RowBox[{
         SubscriptBox["c", "p"], "=", 
         RowBox[{
          FractionBox[
           SubscriptBox["\[Sigma]", 
            SubscriptBox["T", "p"]], 
           RowBox[{"E", "(", 
            SubscriptBox["T", "p"], ")"}]], "=", 
          RowBox[{
           FractionBox[
            SubscriptBox["\[Sigma]", 
             SubscriptBox["T", "p"]], 
            RowBox[{"1", "/", "\[Mu]"}]], "=", 
           RowBox[{
            FractionBox["0.05", 
             RowBox[{"1", "/", "75"}]], "=", "3.75"}]}]}]}]}
      },
      GridBoxAlignment->{"Columns" -> {{"Center"}}}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
  TraditionalForm]],ExpressionUUID->"1c3a0e33-8e00-4849-ba32-c8d42c36b975"]], \
"Text",
 CellChangeTimes->{{3.980589768326826*^9, 3.9805898355279026`*^9}, {
