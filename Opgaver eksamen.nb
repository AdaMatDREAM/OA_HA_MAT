Cell[CellGroupData[{

Cell["a.", "Subsection",
 CellChangeTimes->{{3.980575513722584*^9, 
  3.9805755149982986`*^9}},ExpressionUUID->"a45a6fb5-ab67-6444-8b8e-\
360095f06251"],

Cell[TextData[{
 "For at alle kunderne skal kunne blive betjent, skal have en utilisation, \
som er under 1 (100%).\nFor at beregne denne skal vi kende arrival rate og \
processing rate. Vi ved at det forventes at der kommer 3 kunder hvert minut, \
svarende til at der kommer ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"3", "*", "60"}], "=", "180"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "158f9e35-cd0f-3f4b-97c3-c66942559dde"],
 " kunder pr. time. Dermed bliver arrival rate pr. time"
}], "Text",
 CellChangeTimes->{{3.980575701869892*^9, 3.9805757657325497`*^9}, {
  3.980575802795992*^9, 3.980575874453436*^9}, {3.9805792207944565`*^9, 
  3.980579222909601*^9}},ExpressionUUID->"670d604a-b1b9-5b43-9ebe-\
62d7ae3ce65b"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {GridBox[{
       {
        RowBox[{"\[Lambda]", "=", "180"}]}
      },
      GridBoxAlignment->{"Columns" -> {{"="}}}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
  TraditionalForm]],ExpressionUUID->"c7eb34de-383d-5b4b-9fa2-3524b17f16ad"]], \
"Text",
 CellChangeTimes->{{3.9805758776845436`*^9, 3.9805758955993996`*^9}, {
  3.980579226109316*^9, 
  3.980579229984976*^9}},ExpressionUUID->"4d91f6bb-2d21-7f4c-aaf0-\
97dbcf25614e"],

Cell["\<\
Svarende til at der kommer en kunde hvert 0.0055556 time (forventet \
ventetid). En assistent kan i gennemsnit betjene 75 kunder i timen. \
Processing rate beregnes nu i pr. time endheder\
\>", "Text",
 CellChangeTimes->{{3.980575979643488*^9, 3.980576189473612*^9}, {
  3.9805792371277714`*^9, 
  3.980579242723543*^9}},ExpressionUUID->"ae3a0972-151e-644a-928a-\
7aa3401f12c6"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {GridBox[{
       {
        RowBox[{"\[Mu]", "=", "75"}]}
      },
      GridBoxAlignment->{"Columns" -> {{"="}}}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
  TraditionalForm]],ExpressionUUID->"30093bc2-e8a6-9241-b9f0-2c9e29e13139"]], \
"Text",
 CellChangeTimes->{{3.9805760834164658`*^9, 3.980576093361624*^9}, {
  3.980576165488037*^9, 3.9805761796846848`*^9}, {3.9805792507542133`*^9, 
  3.980579256156069*^9}},ExpressionUUID->"6f41321c-9e67-3347-8462-\
8f04440903f6"],

Cell[TextData[{
 "Svarende til at den gennemsnitlige processeringstid er p\[ARing] 0.0133333 \
timer. Vi vil gerne have at utilisation ",
 Cell[BoxData[
  FormBox[
   RowBox[{"<", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8ec12fdb-31c2-b74a-8dad-2a0387e0adcc"],
 ", og vi skal v\[AE]lge ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "398c138f-fb84-fd44-a9ea-c624a9131fd4"],
 " s\[ARing]ledes at dette bliver tilf\[AE]ldet. Dermed kan vi skrive at"
}], "Text",
 CellChangeTimes->{{3.9805762024362717`*^9, 3.980576229105772*^9}, {
  3.980579258725895*^9, 
  3.9805792734692173`*^9}},ExpressionUUID->"71ac68b0-5faf-5c4c-8cd4-\
16d1fa0e3d81"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{"\[Rho]", "=", 
      RowBox[{
       FractionBox["\[Lambda]", 
        RowBox[{"N", "*", "\[Mu]"}]], "<", "1"}]}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
  TraditionalForm]],ExpressionUUID->"19a723e1-c25e-8b41-851e-29b61aaf507d"]], \
"Text",
 CellChangeTimes->{{3.9805762314110184`*^9, 
  3.9805762661264877`*^9}},ExpressionUUID->"0007f927-2e26-4749-8851-\
5964a1404d3f"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      FractionBox[GridBox[{
         {"180"}
        },
        GridBoxAlignment->{"Columns" -> {{"Center"}}}], 
       RowBox[{"N", "*", "75"}]], "<", "1"}]},
    {
     RowBox[{
      FractionBox["12", 
       RowBox[{"5", "N"}]], "<", "1"}]},
    {
     RowBox[{"12", "<", 
      RowBox[{"5", "N"}]}]},
    {
     RowBox[{
      FractionBox["12", "5"], "<", "N"}]},
    {
     RowBox[{"2.4", "<", "N"}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
  TraditionalForm]],ExpressionUUID->"b1f0f36b-cd19-7b41-bf05-130ba81d9d23"]], \
"Text",
 CellChangeTimes->{{3.9805762689074936`*^9, 3.980576340334484*^9}, {
  3.9805792799446106`*^9, 3.9805792864299297`*^9}, {3.9805793281042137`*^9, 
  3.980579366733349*^9}},ExpressionUUID->"10c9c85b-ca14-6b47-ba6c-\
1e9ed03907b2"],

Cell["\<\
Dermed skal man hyre mindst tre medarbejdere, for at utilisation rate er \
under 1.\
\>", "Text",
 CellChangeTimes->{{3.980576401255745*^9, 3.980576433738907*^9}, {
  3.980579374007578*^9, 
  3.980579376429346*^9}},ExpressionUUID->"685636c1-279c-4446-a025-\
f5848c5816c4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["b", "Subsection",
 CellChangeTimes->{{3.980579454089073*^9, 
  3.980579456564171*^9}},ExpressionUUID->"667837aa-0c8e-3346-96cc-\
09d519576377"],

Cell[TextData[{
 "For at beregne den gennemsnitlige m\[AE]ngde af kunder, som vil v\[AE]re i \
butikken, skal vi beregne inventory processing, som er givet ved ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", " ", 
    TemplateBox[<|
     "boxes" -> FormBox["\[Cross]", TraditionalForm], "errors" -> {}, "input" -> 
      "\\times", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], "N"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bfc3792b-3f23-fb4d-bdee-704ff616c2b6"],
 ". N\[ARing]r der er 50 kunder i gennemsnit pr. time, betyder det at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Lambda]", "=", "50"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "82d80842-8cf0-9c41-a0d2-66e1e172b0b5"],
 ". Derudover har vi at der kun er en som serverer, dermed er ",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e7f5a48b-dcec-e04b-a08a-5408f68ac140"],
 ". Dermed kan vi beregne "
}], "Text",
 CellChangeTimes->{{3.980588290750988*^9, 3.980588386599064*^9}, {
  3.9805884214631996`*^9, 
  3.9805884696996536`*^9}},ExpressionUUID->"61987337-2b73-f047-8fdb-\
3549235fe22a"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {GridBox[{
       {
        RowBox[{"\[Rho]", "=", 
         RowBox[{
          FractionBox["\[Lambda]", 
           RowBox[{"N", "*", "\[Mu]"}]], "=", 
          RowBox[{
           FractionBox["50", "75"], "=", 
           RowBox[{
            FractionBox["2", "3"], "=", "0.66667"}]}]}]}]}
      },
      GridBoxAlignment->{"Columns" -> {{"="}}}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
  TraditionalForm]],ExpressionUUID->"2acb5181-e3ec-514e-84c7-cf48aafe3ffc"]], \
"Text",
 CellChangeTimes->{{3.980588474373598*^9, 
  3.9805885362537994`*^9}},ExpressionUUID->"2c6f67f1-6b5c-ad4c-8c57-\
56ff40bb5100"],

Cell["\<\
Dermed vil der i gennemsnit v\[AE]re 0.66 kunder i systemetet om tirsdagen. \
Vi beregner hvor mange kunder der i gennemsnit vil v\[AE]re i k\[OSlash]:\
\>", "Text",
 CellChangeTimes->{{3.980588543283848*^9, 3.980588583770504*^9}, {
   3.980588831477909*^9, 3.9805888554908924`*^9}, 
   3.9805889468853703`*^9},ExpressionUUID->"f2840194-2807-d041-b6d9-\
