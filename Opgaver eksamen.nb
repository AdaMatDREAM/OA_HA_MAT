Cell["\<\
Vi ser at den gennemsnitlige ventetid er p\[ARing] 0.8 timer. Eftersom der i \
alt er 1000 kunder, ville den samlede forventede ventetid v\[AE]re\
\>", "Text",
 CellChangeTimes->{{3.980592628199995*^9, 
  3.980592658894203*^9}},ExpressionUUID->"0111a5c2-aa11-ea42-8167-\
bf86584806bf"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {GridBox[{
       {
        RowBox[{
         RowBox[{"1000", "*", "0.8"}], "=", "800"}]}
      },
      GridBoxAlignment->{"Columns" -> {{"="}}}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
  TraditionalForm]],ExpressionUUID->"1990211f-7c44-d54e-b562-fc6f347e4b47"]], \
"Text",
 CellChangeTimes->{{3.9805926618840103`*^9, 
  3.9805926750158863`*^9}},ExpressionUUID->"12a6881e-15cd-e44a-94c8-\
6edf86db92a7"],

Cell["\<\
timer. Hvis man f\[ARing]r 10 kroner for hvert minut som man venter, bliver \
den samlede omkostning for ventetid\
\>", "Text",
 CellChangeTimes->{{3.9805926769423294`*^9, 3.980592707764347*^9}, {
  3.9805928249587765`*^9, 
  3.9805928285912476`*^9}},ExpressionUUID->"f6893bd8-8af4-d94a-9d53-\
e2fdfb1a2a91"],

Cell[TextData[Cell[BoxData[
