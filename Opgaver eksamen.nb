                  RowBox[{"5", "f"}]]}]},
               {
                RowBox[{
                 RowBox[{"U", ".", "B", ".", "B", "."}], ":"}]},
               {GridBox[{
                  {
                   RowBox[{
                    RowBox[{
                    SubscriptBox["x", 
