  3.9806676237009087`*^9}},ExpressionUUID->"78901678-eed4-634f-8401-\
619bcd474bc8"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {GridBox[{
       {
        RowBox[{"\[Rho]", "=", 
         RowBox[{
          FractionBox[
           FractionBox["1", "12"], 
           FractionBox["1", "8"]], "=", 
          RowBox[{
           FractionBox["8", "12"], "=", 
           FractionBox["2", "3"]}]}]}]}
      },
      GridBoxAlignment->{"Columns" -> {{"Center"}}}]}
   },
