Cell[TextData[{
 "Dermed bliver den nye betingelse ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"-", "0.03"}], 
      SubscriptBox["s", "3"]}], "+", 
     SubscriptBox["s", "4"]}], "<=", 
    RowBox[{"-", "0.5"}]}], TraditionalForm]],ExpressionUUID->
