Cell[TextData[{
 "Da ser vi at ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ab49bc67-e7f6-844f-9541-de841500c5b0"],
 " er heltalig, men det er ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5067c673-e5e9-4d45-aac2-9ebdf5a58d98"],
 " ikke. Dermed f\[ARing]r vi begr\[AE]nsningernerne ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "1"], "<=", "2"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0761e553-67a0-0144-916d-df4655088f5b"],
 " og ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "1"], ">=", "3"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fd603fa1-c98d-8849-aef9-90d0edf1b828"],
 ". Vi starter med at branche efter ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "1"], "<=", "2"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "234d5bdc-8c1b-3b4d-acd4-aae7a67742c5"]
}], "Text",
 CellChangeTimes->{{3.9785877014416275`*^9, 3.978587702894924*^9}, {
