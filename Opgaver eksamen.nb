Cell[TextData[{
 "Vi brancher med udgangspunkt i ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4cbb3225-6959-3d47-afb2-d1dd71a5513d"],
 " og laver derfor to nye begr\[AE]nsninger ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "2"], ">=", "5"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c30cead8-4d69-d042-868b-06df1cf8dae1"],
 " og ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "2"], "<=", "4"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e457e3cd-9b98-334b-8a88-3617df88bb9d"],
 ". Lad os f\[OSlash]rst branche med udgangspunkt i den f\[OSlash]rste af de \
to begr\[AE]nsninger, alts\[ARing] ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "2"], ">=", "5"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "99471b08-3038-9c46-a932-be31bc0fba61"],
 ". Her f\[ARing]s:"
}], "Text",
