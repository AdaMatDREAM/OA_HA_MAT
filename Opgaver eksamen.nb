Cell["Vi skal maksimerer profitten, som er givet ved", "Text",
 CellChangeTimes->{{3.9807401827760544`*^9, 
  3.9807401943348064`*^9}},ExpressionUUID->"4bdd7c2e-51fa-ec4c-b318-\
e2924d2e2258"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {GridBox[{
       {
        RowBox[{
         RowBox[{
          TemplateBox[<|"boxes" -> FormBox[
              UnderscriptBox["max", 
               StyleBox["x", "TI"], LimitsPositioning -> True], 
              TraditionalForm], "errors" -> {}, "input" -> "\\max_{x}", 
            "state" -> "Boxes"|>,
           "TeXAssistantTemplate"], 
          SuperscriptBox["d", "T"], "p"}], "-", 
         RowBox[{
          SuperscriptBox["x", "T"], 
          SubscriptBox["c", "V"]}], "-", 
         RowBox[{
          SuperscriptBox[
           SubscriptBox["i", "t"], "T"], 
          SubscriptBox["c", "I"]}], "-", 
         RowBox[{
          SuperscriptBox["\[Delta]", "T"], 
          SubscriptBox["c", "F"]}]}]}
      },
      GridBoxAlignment->{"Columns" -> {{"="}}}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
  TraditionalForm]],ExpressionUUID->"6e07e415-0c10-7d4a-bc58-be4fb29f5171"]], \
"Text",
 CellChangeTimes->{{3.9807401971453915`*^9, 3.9807402075669727`*^9}, {
  3.980740275274725*^9, 3.980740355742943*^9}, {3.9807404069790344`*^9, 
  3.980740549861107*^9}, {3.98074058050675*^9, 3.9807406345469704`*^9}, {
  3.980741286931341*^9, 
  3.980741287089329*^9}},ExpressionUUID->"9117e2f8-6474-794d-a9b0-\
22325b0f3cd0"],

Cell["Hvor", "Text",
 CellChangeTimes->{{3.980740637302744*^9, 
  3.980740639328163*^9}},ExpressionUUID->"e06c4323-8eff-c947-a7ae-\
379698b42860"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {GridBox[{
       {
        RowBox[{"d", "=", 
         RowBox[{
          RowBox[{"(", GridBox[{
             {
              RowBox[{
               SubscriptBox["d", "1"], " "}]},
             {
              SubscriptBox["d", "2"]},
             {
              
              TemplateBox[<|
               "boxes" -> FormBox["\[VerticalEllipsis]", TraditionalForm], 
                "errors" -> {}, "input" -> "\\vdots", "state" -> "Boxes"|>,
               "TeXAssistantTemplate"]},
             {
              SubscriptBox["d", "k"]}
            }], ")"}], "=", 
          RowBox[{
          "eftersp\[OSlash]rgsel", " ", "hver", " ", "periode", " ", "i", " ",
            "enheder"}]}]}]},
       {
        RowBox[{"p", "=", 
         RowBox[{
          RowBox[{"(", GridBox[{
             {
              RowBox[{
               SubscriptBox["p", "1"], " "}]},
             {
              SubscriptBox["p", "2"]},
             {
              
              TemplateBox[<|
               "boxes" -> FormBox["\[VerticalEllipsis]", TraditionalForm], 
                "errors" -> {}, "input" -> "\\vdots", "state" -> "Boxes"|>,
               "TeXAssistantTemplate"]},
             {
              SubscriptBox["p", "k"]}
            }], ")"}], "=", 
          RowBox[{"pris", " ", 
           RowBox[{"pr", ".", " ", "enhed"}], " ", "i", " ", "hver", " ", 
           "periode"}]}]}]},
       {
        RowBox[{"x", "=", 
         RowBox[{
          RowBox[{"(", GridBox[{
             {
              SubscriptBox["x", "1"]},
             {
              SubscriptBox["x", "2"]},
             {
              
              TemplateBox[<|
               "boxes" -> FormBox["\[VerticalEllipsis]", TraditionalForm], 
                "errors" -> {}, "input" -> "\\vdots", "state" -> "Boxes"|>,
               "TeXAssistantTemplate"]},
             {
              SubscriptBox["x", "k"]}
            }], ")"}], "=", 
          RowBox[{
          "hvor", " ", "meget", " ", "man", " ", "producerer", " ", "i", " ", 
           "hver", " ", "periode", " ", 
           RowBox[{"(", "beslutningvariabel", ")"}]}]}]}]},
       {
        RowBox[{
         SubscriptBox["c", "V"], "=", 
         RowBox[{
          RowBox[{"(", GridBox[{
             {
              RowBox[{
               SubscriptBox[
                SubscriptBox["c", "V"], "1"], " "}]},
             {
              SubscriptBox[
               SubscriptBox["c", "V"], "2"]},
             {
              
              TemplateBox[<|
               "boxes" -> FormBox["\[VerticalEllipsis]", TraditionalForm], 
                "errors" -> {}, "input" -> "\\vdots", "state" -> "Boxes"|>,
               "TeXAssistantTemplate"]},
             {
              SubscriptBox[
               SubscriptBox["c", "V"], "k"]}
            }], ")"}], "=", 
          RowBox[{"Variable", " ", "omkostninger", " ", 
           RowBox[{"pr", ".", " ", "enhed"}]}]}]}]},
       {
        RowBox[{
         SubscriptBox["i", "t"], "=", 
         RowBox[{
          RowBox[{"(", GridBox[{
             {
              SubscriptBox["i", "0"]},
             {
              RowBox[{
               SubscriptBox["i", "1"], " "}]},
             {
              SubscriptBox["i", "2"]},
             {
              
              TemplateBox[<|
               "boxes" -> FormBox["\[VerticalEllipsis]", TraditionalForm], 
                "errors" -> {}, "input" -> "\\vdots", "state" -> "Boxes"|>,
               "TeXAssistantTemplate"]},
             {
              SubscriptBox["i", "k"]}
            }], ")"}], "=", 
          RowBox[{
          "m\[AE]ngden", " ", "p\[ARing]", " ", "lager", " ", "i", " ", 
           "periode", " ", "t"}]}]}]},
       {
        RowBox[{
         SubscriptBox["c", "I"], "=", 
         RowBox[{
          RowBox[{"(", GridBox[{
             {
              SubscriptBox[
               SubscriptBox["c", "I"], "0"]},
             {
              RowBox[{
               SubscriptBox[
                SubscriptBox["c", "I"], "1"], " "}]},
             {
              SubscriptBox[
               SubscriptBox["c", "I"], "2"]},
             {
              
              TemplateBox[<|
               "boxes" -> FormBox["\[VerticalEllipsis]", TraditionalForm], 
                "errors" -> {}, "input" -> "\\vdots", "state" -> "Boxes"|>,
               "TeXAssistantTemplate"]},
             {
              SubscriptBox[
               SubscriptBox["c", "I"], "k"]}
            }], ")"}], "=", 
          RowBox[{"Lager", " ", "omkostninger", " ", 
           RowBox[{"pr", ".", " ", "enhed"}]}]}]}]},
       {
        RowBox[{"\[Delta]", "=", 
         RowBox[{
          RowBox[{"(", GridBox[{
             {
              RowBox[{
               SubscriptBox["\[Delta]", "1"], " "}]},
             {
              SubscriptBox["\[Delta]", "2"]},
             {
              
              TemplateBox[<|
               "boxes" -> FormBox["\[VerticalEllipsis]", TraditionalForm], 
                "errors" -> {}, "input" -> "\\vdots", "state" -> "Boxes"|>,
               "TeXAssistantTemplate"]},
             {
              SubscriptBox["\[Delta]", "k"]}
            }], ")"}], "=", 
          RowBox[{
          "produceres", " ", "der", " ", "postivite", " ", "enheder", " ", 
           "s\[ARing]", " ", "1", " ", "eller", " ", "0"}]}]}]},
       {
        RowBox[{
         SubscriptBox["c", "F"], "=", 
         RowBox[{
          RowBox[{"(", GridBox[{
             {
              RowBox[{
               SubscriptBox[
                SubscriptBox["c", "F"], "1"], " "}]},
             {
              SubscriptBox["c", 
               RowBox[{"F", " ", "2"}]]},
             {
              
              TemplateBox[<|
               "boxes" -> FormBox["\[VerticalEllipsis]", TraditionalForm], 
                "errors" -> {}, "input" -> "\\vdots", "state" -> "Boxes"|>,
               "TeXAssistantTemplate"]},
             {
              SubscriptBox["c", 
               RowBox[{"F", " ", "k"}]]}
            }], ")"}], "=", 
          RowBox[{
          "Faste", " ", "omkostnigner", " ", "for", " ", "en", " ", "given", " ",
            "periode"}]}]}]}
      },
      GridBoxAlignment->{"Columns" -> {{"Center"}}}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
  TraditionalForm]],ExpressionUUID->"f8fb9a20-1122-4c4f-8990-31c6e2a245e6"]], \
"Text",
 CellChangeTimes->{{3.9807406437180195`*^9, 3.9807407713862953`*^9}, {
  3.9807409655947056`*^9, 3.9807409655947056`*^9}, {3.9807410007139854`*^9, 
