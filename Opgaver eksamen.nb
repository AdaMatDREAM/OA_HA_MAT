Cell[CellGroupData[{

Cell["(a)", "Subsection",
 CellChangeTimes->{{3.9778261822720184`*^9, 
  3.9778261828637753`*^9}},ExpressionUUID->"150a33e0-4cca-5742-bb2b-\
740328996fba"],

Cell[TextData[{
 "Vi definerer to beslutningsvariable, en for hver produkttype. \n",
 Cell[BoxData[{
  FormBox[
   RowBox[{
    SubscriptBox["x", "1"], "=", 
    RowBox[{"m\[AE]ngde", " ", "af", " ", "produkttype", " ", "1"}]}], 
   TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    SubscriptBox["x", "2"], "=", 
    RowBox[{"m\[AE]ngde", " ", "af", " ", "produkttype", " ", "2"}]}], 
   TraditionalForm]}],
  FormatType->TraditionalForm,ExpressionUUID->
  "e752d00a-a362-7d4b-b294-a946c3d904aa"],
 "\nVi ved at profitten er givet ved 1 krone for produkt 1 og 2 kroner for \
produkt 2. Dermed bliver objektiv funktionen ",
 Cell[BoxData[
  FormBox[
   RowBox[{"z", "=", 
    RowBox[{
     SubscriptBox["x", "1"], "+", 
     RowBox[{"2", 
      SubscriptBox["x", "2"]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7297df3a-1379-a14b-8add-7e000c3ac53b"],
 " hvor ",
 Cell[BoxData[
  FormBox["z", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "819ce476-b312-724d-a241-aa6330ed4e5e"],
 " m\[ARing]ler profit i kroner. "
}], "Text",
 CellChangeTimes->{{3.97782624374634*^9, 
  3.9778263556660748`*^9}},ExpressionUUID->"dfb27a20-7462-3244-ae2d-\
ed7d5bdc8135"]
}, Open  ]],

Cell[CellGroupData[{

Cell["(b) og (c)", "Subsection",
 CellChangeTimes->{{3.9778263658348484`*^9, 3.9778263667454987`*^9}, {
  3.9778267176623898`*^9, 
  3.9778267191443596`*^9}},ExpressionUUID->"e4046752-9184-dd48-8dd2-\
9f90dacee6f4"],

Cell["\<\
Her ses en oversigt over rescourcebrug for de forskellige produkttyper, samt \
m\[AE]ngden er rescourcer til r\[ARing]dighed\
\>", "Text",
 CellChangeTimes->{{3.977826406697748*^9, 
  3.977826429361103*^9}},ExpressionUUID->"4b9fa048-8663-fb47-9d90-\
4ade1a9b71f5"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {GridBox[{
       {
        TagBox[GridBox[{
           {
            RowBox[{"Rescourceforbrug", "/", "Produkttype"}], 
            SubscriptBox["x", "1"], 
            SubscriptBox["x", "2"], "Kapacitet"},
           {
            RowBox[{"Rescource", " ", "1"}], "1", "3", "200"},
           {
            RowBox[{"Rescource", " ", "2"}], "2", "2", "300"}
          },
          GridBoxDividers->{"Columns" -> {{True}}, "Rows" -> {{True}}}],
         "Grid"]}
      },
      GridBoxAlignment->{"Columns" -> {{"Center"}}}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
  TraditionalForm]],ExpressionUUID->"5c2b20b1-c0a3-cf4b-85d3-08a0480666d9"]], \
"Text",
 CellChangeTimes->{{3.977826442542679*^9, 
  3.9778266095287895`*^9}},ExpressionUUID->"1d781c38-0f8e-984a-a4ae-\
32dc330c509b"],

Cell["\<\
Derudover kan der maksimalt s\[AE]lges 60 enheder af produkt 2. Da bliver \
bibetingelserne \
\>", "Text",
 CellChangeTimes->{{3.9778266119273376`*^9, 
  3.9778266343451004`*^9}},ExpressionUUID->"d7bc991f-5f6e-c041-861c-\
12a8723e659c"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {GridBox[{
       {
        RowBox[{
         RowBox[{
          SubscriptBox["x", "1"], "+", 
          RowBox[{"3", 
           SubscriptBox["x", "2"]}]}], "<=", "200"}]},
       {
        RowBox[{
         RowBox[{
          RowBox[{"2", 
           SubscriptBox["x", "1"]}], "+", 
          RowBox[{"2", 
           SubscriptBox["x", "2"]}]}], "<=", 
         RowBox[{
          RowBox[{"300", "\[DoubleLongRightArrow]", 
           SubscriptBox["x", "1"]}], "+", 
          SubscriptBox["x", "2"]}], "<=", "150"}]},
       {
        RowBox[{
         SubscriptBox["x", "2"], "<=", "60"}]}
      },
      GridBoxAlignment->{"Columns" -> {{"="}}}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
  TraditionalForm]],ExpressionUUID->"cda37770-6d09-b043-b14c-12a1d79550e8"]], \
"Text",
 CellChangeTimes->{{3.977826636740307*^9, 
  3.977826702379566*^9}},ExpressionUUID->"15029c1c-0bf7-cf40-b618-\
082787606369"]
}, Open  ]],

Cell[CellGroupData[{

Cell["(d)", "Subsection",
 CellChangeTimes->{{3.9778267344800663`*^9, 
  3.9778267350916195`*^9}},ExpressionUUID->"8457ccb5-7ec3-e549-a27f-\
609c83d4d3b7"],

Cell["Vi f\[ARing]r det samlede maksimeringsproblem", "Text",
 CellChangeTimes->{{3.977826724812847*^9, 
  3.9778267307219963`*^9}},ExpressionUUID->"7ad932b4-48d7-0b43-98bf-\
4dbe5d00b96b"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {GridBox[{
       {
        RowBox[{
         RowBox[{"max", " ", 
          SubscriptBox["x", "1"]}], "+", 
         RowBox[{"2", 
          SubscriptBox["x", "2"]}]}]},
       {
        RowBox[{"u", ".", "b", ".", "b"}]},
       {
        RowBox[{
         RowBox[{
          SubscriptBox["x", "1"], "+", 
          RowBox[{"3", 
           SubscriptBox["x", "2"]}]}], "<=", "200"}]},
       {
        RowBox[{
         RowBox[{
          SubscriptBox["x", "1"], "+", 
          SubscriptBox["x", "2"]}], "<=", "150"}]},
       {
        RowBox[{
         SubscriptBox["x", "2"], "<=", "60"}]},
       {
        RowBox[{
         SubscriptBox["x", "1"], ",", 
         RowBox[{
          SubscriptBox["x", "2"], ">=", "0"}]}]}
      },
      GridBoxAlignment->{"Columns" -> {{"Center"}}}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
  TraditionalForm]],ExpressionUUID->"242eea6f-607a-ad40-809d-c8bc6f7962dd"]], \
"Text",
 CellChangeTimes->{{3.977826775586008*^9, 3.977826799573532*^9}, {
  3.9778268333697033`*^9, 
  3.9778268377903614`*^9}},ExpressionUUID->"e65c838b-b047-cd43-9171-\
4dac91d94c79"],

