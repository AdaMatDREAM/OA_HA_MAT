Cell[CellGroupData[{

Cell["a)", "Subsection",
 CellChangeTimes->{{3.980601994432497*^9, 
  3.9806019947417297`*^9}},ExpressionUUID->"3c3f0d0c-191a-4943-a5dc-\
1d5487d919a7"],

Cell["\<\
Freja kan v\[AE]lge mellem tre forskellige bygningsenheder, for at bygge p\
\[ARing] sin brakmark, og disse vil konstituerer vores beslutningsvariable i \
dette problem. Hun kan v\[AE]lge mellem\
\>", "Text",
 CellChangeTimes->{{3.9806021472093887`*^9, 
  3.9806021902544994`*^9}},ExpressionUUID->"e7c5eef0-7cc9-f74a-8708-\
ccf8f78597c5"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {GridBox[{
       {
        RowBox[{
         SubscriptBox["x", "a"], "=", 
         RowBox[{
          RowBox[{"Antal", " ", "mikro"}], "-", "atomkraftv\[AE]rker"}]}]},
       {
        RowBox[{
         SubscriptBox["x", "b"], "=", 
         RowBox[{"Antal", " ", "solpaneller"}]}]},
       {
        RowBox[{
         SubscriptBox["x", "c"], "=", 
         RowBox[{"antal", " ", "vindm\[OSlash]ller"}]}]}
      },
      GridBoxAlignment->{"Columns" -> {{"="}}}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
  TraditionalForm]],ExpressionUUID->"f54a7b22-ed9a-964d-92b1-7ffc9402aeb9"]], \
"Text",
 CellChangeTimes->{{3.980602192981266*^9, 
  3.980602243216629*^9}},ExpressionUUID->"d385e1d4-1e08-c246-8ec2-\
3734e0147eff"],

Cell["\<\
Vi har f\[ARing]et f\[OSlash]lgende informationer, som her er sat p\[ARing] \
tabelform\
\>", "Text",
 CellChangeTimes->{{3.9806022639573994`*^9, 
  3.98060227411051*^9}},ExpressionUUID->"60490a2e-b01e-d840-b941-\
850ba465d6b6"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {GridBox[{
       {
        TagBox[GridBox[{
           {"Type", 
            SubscriptBox["x", "a"], 
            SubscriptBox["x", "b"], 
            SubscriptBox["x", "c"], 
            RowBox[{"evt", ".", " ", "begr\[AE]nsning"}]},
           {"Pris", "100000", "5000", "15000", 
            RowBox[{"<=", "800000", " "}]},
           {
            RowBox[{"Antal", " ", 
             RowBox[{"kvm", "."}]}], 
            RowBox[{
             FractionBox["1000", "10"], "=", "100"}], 
            RowBox[{
             FractionBox["1000", "1000"], "=", "1"}], 
            RowBox[{
             FractionBox["1000", "50"], "=", "20"}], 
            RowBox[{"<=", "1000"}]},
           {
            RowBox[{"Sociale", " ", "kreditscore"}], 
            RowBox[{"-", "10"}], "1", "1", 
            RowBox[{">=", "100"}]},
           {
            RowBox[{"kWh", " ", "produceret"}], "4000", "20", "300", " "}
          },
          GridBoxDividers->{"Columns" -> {{True}}, "Rows" -> {{True}}}],
         "Grid"]}
      },
      GridBoxAlignment->{"Columns" -> {{"Center"}}}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
  TraditionalForm]],ExpressionUUID->"b08b6a6e-9870-8841-90fe-b722420b010f"]], \
"Text",
 CellChangeTimes->{{3.9806022771848774`*^9, 
  3.98060259633922*^9}},ExpressionUUID->"dbfd8824-e44a-b64f-8d27-\
9a8c1718ae48"],

Cell["\<\
Eftersom freja \[OSlash]nsker at maksimerer m\[AE]ngden af str\[OSlash]m \
produceret, bliver objektivfunktionen nedenst\[ARing]ende (som skal \
maksimeres)\
\>", "Text",
 CellChangeTimes->{{3.9806026060881557`*^9, 
  3.980602647745062*^9}},ExpressionUUID->"8e603016-e23d-8344-8180-\
643f1ec10848"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {GridBox[{
       {
        RowBox[{
         RowBox[{
          TemplateBox[<|"boxes" -> FormBox[
              UnderscriptBox["max", 
               RowBox[{
                 SubscriptBox[
                  StyleBox["x", "TI"], 
                  StyleBox["a", "TI"]], ",", 
                 SubscriptBox[
                  StyleBox["x", "TI"], 
                  StyleBox["b", "TI"]], ",", 
                 SubscriptBox[
                  StyleBox["x", "TI"], 
                  StyleBox["c", "TI"]]}], LimitsPositioning -> True], 
              TraditionalForm], "errors" -> {}, "input" -> 
            "\\max_{x_a,x_b,x_c}", "state" -> "Boxes"|>,
           "TeXAssistantTemplate"], "z"}], "=", 
         RowBox[{
          RowBox[{"4000", 
           SubscriptBox["x", "a"]}], "+", 
          RowBox[{"20", 
           SubscriptBox["x", "b"]}], "+", 
          RowBox[{"300", 
           SubscriptBox["x", "c"]}]}]}]}
      },
      GridBoxAlignment->{"Columns" -> {{"="}}}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
  TraditionalForm]],ExpressionUUID->"d8d3b49c-4668-2c45-bf58-da6407dea03b"]], \
"Text",
 CellChangeTimes->{{3.9806026525752583`*^9, 
  3.9806027021298504`*^9}},ExpressionUUID->"b984d7fd-47fe-c44a-9b94-\
4ebaa3c81a39"],

Cell["Og hertil er f\[OSlash]lgende begr\[AE]nsninger", "Text",
 CellChangeTimes->{{3.9806027053742695`*^9, 
  3.9806027122567883`*^9}},ExpressionUUID->"38c24e04-5aca-2448-9601-\
62ae87dcbd3a"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {GridBox[{
       {
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", "Pris", ")"}], "  ", "100000", 
           SubscriptBox["x", "a"]}], "+", 
          RowBox[{"5000", 
           SubscriptBox["x", "b"]}], "+", 
          RowBox[{"15000", 
           SubscriptBox["x", "c"]}]}], "<=", "800000"}]},
       {
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", "Kvm", ")"}], "  ", "100", 
           SubscriptBox["x", "a"]}], "+", 
          SubscriptBox["x", "b"], "+", 
          RowBox[{"20", 
           SubscriptBox["x", "c"]}]}], "<=", "1000"}]},
       {
        RowBox[{
         RowBox[{
          RowBox[{"(", "SK", ")"}], " ", "-", 
          RowBox[{"10", 
           SubscriptBox["x", "a"]}], "+", 
          SubscriptBox["x", "b"], "+", 
          SubscriptBox["x", "c"]}], ">=", "100"}]}
      },
      GridBoxAlignment->{"Columns" -> {{"="}}}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
  TraditionalForm]],ExpressionUUID->"08bf6df9-2e7b-3849-a947-64d908e85e78"]], \
"Text",
 CellChangeTimes->{{3.980602715225111*^9, 
  3.980602866951271*^9}},ExpressionUUID->"f8ea17c7-cac7-b74e-ba73-\
649ece3be1f9"],

