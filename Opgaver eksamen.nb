Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[GridBox[{
     {GridBox[{
        {
         RowBox[{
          RowBox[{"E", "(", 
           SubscriptBox["T", "q"], ")"}], "=", 
          RowBox[{
           RowBox[{
            FractionBox[
             RowBox[{
              SuperscriptBox["0.6", "2"], "+", 
              SuperscriptBox["3.75", "2"]}], "2"], "*", 
            FractionBox["0.8", 
             RowBox[{"1", "-", "0.8"}]], "*", 
            FractionBox["1", "75"]}], "=", GridBox[{
             {"0.3846000000000001`"}
            },
            
            GridBoxAlignment->{
             "Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
            GridBoxSpacings->{"Columns" -> {
                Offset[0.27999999999999997`], {
                 Offset[0.7]}, 
                Offset[0.27999999999999997`]}, "Rows" -> {
                Offset[0.2], {
                 Offset[0.4]}, 
                Offset[0.2]}}]}]}]}
       },
