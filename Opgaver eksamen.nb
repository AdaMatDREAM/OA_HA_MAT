Cell[CellGroupData[{

Cell["(d)", "Subsection",
 CellChangeTimes->{{3.9787587241065655`*^9, 
  3.9787587249407043`*^9}},ExpressionUUID->"33265c0f-8bbd-6d4b-ae62-\
a089544f4188"],

Cell["\<\
L\[OSlash]sning nummer 2, er ikke mulig, eftersom man i traveling salesman \
problem ikke kan tage fra by C til by C. 
L\[OSlash]sning nummer 1 er mulig, da man tager fra A \
\[Rule]B\[Rule]C\[Rule]D\[Rule]A.\
\>", "Text",
 CellChangeTimes->{{3.9787587325516834`*^9, 3.978758781851639*^9}, {
  3.978758939542284*^9, 
  3.978758995421631*^9}},ExpressionUUID->"fd70d989-75d3-d541-bd4b-\
f5c962731ce0"]
}, Open  ]]
}, Closed]],

