Cell[CellGroupData[{

Cell["(c)", "Subsection",
 CellChangeTimes->{{3.978451289899542*^9, 
  3.978451290698393*^9}},ExpressionUUID->"b1f6a8af-44bc-e142-bfb1-\
01bf205fa23c"],

Cell[TextData[{
 "Vi skal omsrive en tilbagev\[AE]rende bibetingelse til en simplere \
bibetingelse. Vi ser at hvis ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "4"], "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "363e7984-2659-4c44-a10e-477e33a4f9b8"],
 " s\[ARing] skal ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "2"], "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b062f145-80c1-b54e-a756-8c75140c13e8"],
 " og vi f\[ARing]r fra forureningsbetingelsen at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "1"], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d1320019-eba3-f94d-abd1-29b02dc4c586"],
 ". Hvis derimod at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "1"], "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "baf17262-2d79-ef4d-b391-d954f3d1e784"],
 " s\[ARing] er ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "4"], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2eb17c04-4e2e-6e46-94b7-844d90ba5d87"],
 " og da vil man have mulighed for at s\[AE]tte ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "2"], "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c2fb5df7-c80d-2f44-9db5-b60e1aef2a3e"],
 " uden at bryde nogle betingelser. Hvis ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "2"], "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "83f00631-785d-d049-b5be-c17ea2c72e0d"],
 " s\[ARing] kan jeg v\[AE]lge mellem ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "1"], "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "02fcb195-3ead-0c47-92fd-308230001606"],
 " eller ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "4"], "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "417430ae-b51f-c448-98fa-e62ded6dd8c5"],
 ". Det betyder alts\[ARing] at:\nHvis ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "1"], "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "89630d89-8783-be45-aef6-92b88fe6ea77"],
 " s\[ARing] er ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "2"], "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8b649b83-1b2d-0c40-959a-da4114b7d93a"],
 " og ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "4"], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0360cf74-1cea-c84b-a12b-c5c621762fc8"],
 ". \nHvis ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "4"], "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1c45577a-f8da-a545-801c-f8c28010aa6d"],
 " s\[ARing] er ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "2"], "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b95ab0c5-11c5-ff45-9040-fce3bb9e88c6"],
 " og ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "1"], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "80f8d6c1-3a93-0a4c-908c-66e9b562e2d9"],
 ".\nHvis ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "2"], "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c2c6ffe1-76f7-9d44-ade8-cb097493119c"],
 " s\[ARing] er enten ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "1"], "=", 
    RowBox[{
     RowBox[{"1", " ", "og", " ", 
      SubscriptBox["x", "4"]}], "=", "0"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "47f2c9fb-03c0-484b-8d93-9ca2b253b1f5"],
 " eller ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "1"], "=", 
    RowBox[{
     RowBox[{"0", " ", "og", " ", 
      SubscriptBox["x", "4"]}], "=", "1"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fe052ea6-e872-d947-adaa-266e57ed19a6"],
 ". \nI alle tilf\[AE]lde er ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "2"], "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bdc4f462-29ba-194d-bd9e-b60049a627ad"],
 ", og dermed ved vi at dette altid vil v\[AE]re g\[AE]ldende.  \nDa bliver \
vores betingelser"
}], "Text",
 CellChangeTimes->{{3.9784512934885864`*^9, 3.978451311978903*^9}, {
  3.9784518998877773`*^9, 3.978452002883768*^9}, {3.9784520380219536`*^9, 
