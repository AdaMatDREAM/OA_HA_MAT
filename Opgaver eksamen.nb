Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{GridBox[{
         {
          TemplateBox[<|"boxes" -> FormBox[
              UnderscriptBox["max", 
               RowBox[{
                 SubscriptBox[
                  StyleBox["x", "TI"], 
                  StyleBox["V", "TI"]], ",", 
                 SubscriptBox[
                  StyleBox["x", "TI"], 
                  StyleBox["K", "TI"]], ",", 
                 SubscriptBox[
                  StyleBox["x", "TI"], 
                  StyleBox["M", "TI"]]}], LimitsPositioning -> True], 
              TraditionalForm], "errors" -> {}, "input" -> 
            "\\max_{x_V,x_K,x_M}", "state" -> "Boxes"|>,
           "TeXAssistantTemplate"]}
        },
        GridBoxAlignment->{"Columns" -> {{"Center"}}}], "1400", 
       SubscriptBox["x", "V"]}], "+", 
      RowBox[{"910", 
       SubscriptBox["x", "K"]}], "+", 
      RowBox[{"6000", 
       SubscriptBox["x", "M"]}]}]},
    {
     RowBox[{
      RowBox[{"U", ".", "B", ".", "B", "."}], ":"}]},
    {
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", "Budget", ")"}], "12000", 
        SubscriptBox["x", "V"]}], "+", 
       RowBox[{"9500", 
        SubscriptBox["x", "K"]}], "+", 
       RowBox[{"50000", 
        SubscriptBox["x", "M"]}]}], "<=", "270000"}]},
    {
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Maks", ".", " ", 
         SubscriptBox["x", "M"]}], ")"}], "  ", 
       SubscriptBox["x", "M"]}], "<=", "2"}]},
    {
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", "R\[ARing]dighed", ")"}], " ", 
        SubscriptBox["x", "V"]}], "+", 
       SubscriptBox["x", "K"], "+", 
       SubscriptBox["x", "M"]}], ">=", "12"}]},
    {
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"Balance", " ", "1"}], ")"}], " ", 
