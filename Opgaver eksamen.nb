  3.9784362170431175`*^9}},ExpressionUUID->"37042f7f-8c3c-3d48-807f-\
1ce3f780da48"],

Cell[TextData[{
 "Vi skal finde \[OSlash]vre gr\[AE]nser for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["b", "i"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0aaa6d03-221e-9d4b-93e1-595d5d1f3af4"],
 "\[CloseCurlyQuote]erne. vi bem\[AE]rker at ingen af dem er basisvariable \
(de tilh\[OSlash]rende slackvariable), samt at s\[OSlash]jlerne som \
h\[OSlash]rer til slackvariablene b\[ARing]de er positive og negative. Da \
bliver \[OSlash]vre hhv. nedre gr\[AE]nse for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["b", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d53d6533-64d3-5348-a3e5-98ffebfe8ab9"]
