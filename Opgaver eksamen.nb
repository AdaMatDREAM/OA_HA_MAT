    RowBox[{
     RowBox[{"u3", "+", "v2"}], "==", "3"}], ",", "\[IndentingNewLine]", 
    RowBox[{"u1", "==", "0"}]}], "\[IndentingNewLine]", "}"}], "]"}]], "Input",
 CellChangeTimes->{{3.9787930913280697`*^9, 3.9787931388310356`*^9}},
