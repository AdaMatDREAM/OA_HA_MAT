Cell[TextData[{
 "Vi opstiller nu ligningerne ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["u", "i"], "+", 
      SubscriptBox["v", "j"]}], "=", 
     RowBox[{
      SubscriptBox["c", 
       RowBox[{"i", " ", "j"}]], 
      RowBox[{"\[ForAll]", "i"}]}]}], ",", "j"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "26576a5a-235d-af43-9163-ef034ace6816"],
 " hvor der er basisvariable. Vi f\[ARing]r ligningerne"
}], "Text",
