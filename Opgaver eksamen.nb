Cell["Den gennemsnitlige forventede k\[OSlash] bliver p\[ARing]", "Text",
 CellChangeTimes->{{3.9806687015127335`*^9, 
  3.9806687164942436`*^9}},ExpressionUUID->"6de0e1a1-88a9-9b43-8f0b-\
649349a45250"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {GridBox[{
       {
        RowBox[{
         SubscriptBox["l", "q"], "=", 
         RowBox[{
          RowBox[{"\[Lambda]", "*", 
           SubscriptBox["T", "q"]}], "=", 
          RowBox[{
