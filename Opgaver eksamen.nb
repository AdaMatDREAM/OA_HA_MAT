16c9a377caef"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {GridBox[{
       {
        RowBox[{
         RowBox[{
          TemplateBox[<|"boxes" -> FormBox[
              UnderscriptBox["max", 
               RowBox[{
                 SubscriptBox[
                  StyleBox["x", "TI"], 
                  StyleBox["s", "TI"]], ",", 
                 SubscriptBox[
                  StyleBox["x", "TI"], "3"], ",", 
                 SubscriptBox[
                  StyleBox["x", "TI"], 
                  StyleBox["x", "TI"]]}], LimitsPositioning -> True], 
              TraditionalForm], "errors" -> {}, "input" -> 
            "\\max_{x_s,x_3,x_x}", "state" -> "Boxes"|>,
           "TeXAssistantTemplate"], "99990", 
          SubscriptBox["x", "s"]}], "+", 
         RowBox[{"54190", 
          SubscriptBox["x", "3"]}], "+", 
         RowBox[{"109990", 
          SubscriptBox["x", "x"]}]}]},
       {
        RowBox[{"U", ".", "B", ".", "B"}]},
       {
        RowBox[{
         RowBox[{
          RowBox[{"2.5", 
           SubscriptBox["x", "s"]}], "+", 
          RowBox[{"4.75", 
           SubscriptBox["x", "3"]}], "+", 
          RowBox[{"1.25", 
           SubscriptBox["x", "x"]}]}], "<=", "2520"}]},
       {
        RowBox[{
         RowBox[{
          RowBox[{"2.05", 
           SubscriptBox["x", "s"]}], "+", 
          RowBox[{"1.87", 
           SubscriptBox["x", "3"]}], "+", 
          RowBox[{"3.6", 
           SubscriptBox["x", "x"]}]}], "<=", "12975"}]},
       {
        RowBox[{
         RowBox[{
          RowBox[{"2.4", 
           SubscriptBox["x", "s"]}], "+", 
          RowBox[{"4.8", 
           SubscriptBox["x", "x"]}]}], "<=", "25380"}]},
       {
        RowBox[{
         RowBox[{"2", 
          SubscriptBox["x", "x"]}], "<=", "10542"}]},
       {
        RowBox[{
         SubscriptBox["x", "3"], "<=", "7500"}]},
       {
        RowBox[{
         RowBox[{"-", 
          SubscriptBox["x", "3"]}], "<=", 
         RowBox[{"-", "6371"}]}]}
      },
      GridBoxAlignment->{"Columns" -> {{"Center"}}}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
  TraditionalForm]],ExpressionUUID->"188169ef-acdd-934c-b7c3-1751c8d72474"]], \
"Text",
 CellChangeTimes->{{3.9808319690478954`*^9, 3.9808321360179157`*^9}, {
  3.980832281132971*^9, 3.980832360489525*^9}, {3.980833117658272*^9, 
  3.9808331231778946`*^9}},ExpressionUUID->"727c756c-22e3-fd46-bcfc-\
c892e2f3cf98"],

Cell[TextData[{
 "Samt natulige begr\[AE]nsninger ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "s"], ",", 
    SubscriptBox["x", "3"], ",", 
    RowBox[{
     SubscriptBox["x", "x"], ">=", "0"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "382df49e-d8a1-b247-b682-453af1f7d376"],
 ", da man ikke kan producerer negative enheder. "
}], "Text",
