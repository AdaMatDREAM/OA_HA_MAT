Cell[TextData[{
 "Der vil her forekomme en informationsoversigt, som skal hj\[AE]lpe med at \
opstille modellen. Her er beslutningsvariablene\n- ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "s"], "=", 
    RowBox[{
    "Antal", " ", "producerede", " ", "model", " ", "s", " ", 
     "k\[OSlash]ret\[OSlash]jer"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8f4c41d9-d2f0-c84b-ba56-3dcc514c93fb"],
 "\n- ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "3"], "=", 
    RowBox[{
    "Antal", " ", "producerede", " ", "model", " ", "3", " ", 
     "k\[OSlash]ret\[OSlash]jer"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a9f81ab4-2b8d-5e4a-bebd-2e1dbe2260b0"],
 "\n- ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "x"], "=", 
    RowBox[{
    "Antal", " ", "producerede", " ", "model", " ", "x", " ", 
     "k\[OSlash]ret\[OSlash]jer"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9eda5120-9cba-2e4e-ad2c-bda9ed849a2e"],
 "\n",
 StyleBox["Oriana vil maksimerer sit salg. \n- ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "s"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d25104f1-fec3-1145-84a3-0a77bc78ef6f"],
 " koster ",
 Cell[BoxData[
  FormBox["99990", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9606edbc-27e8-1a4c-934d-78c334abec48"],
 "\n- ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "05a36137-31f1-5d45-ab29-a0cb94689a9e"],
 " koster ",
 Cell[BoxData[
  FormBox["54190", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d97e8ded-685e-fb48-bf36-93ba345fc2eb"],
 "\n- ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "x"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0dbca693-74ff-4542-bf1f-d7e4a37e4f9c"],
 " koster ",
 Cell[BoxData[
  FormBox["109990", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f6c5d437-b6df-5742-9fc8-e2f266f5cf34"]
}], "Text",
