Cell[CellGroupData[{

Cell["(a)", "Subsection",
 CellChangeTimes->{{3.978432322888283*^9, 
  3.978432323317831*^9}},ExpressionUUID->"50638437-597f-2841-8dde-\
d9adfe05ba84"],

Cell["Det dual program bliver", "Text",
 CellChangeTimes->{{3.9784322191884785`*^9, 
  3.978432223653616*^9}},ExpressionUUID->"3562bf28-20ed-5c4d-92dc-\
cf69172dbc59"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {
     RowBox[{
      RowBox[{GridBox[{
         {"Min"}
        },
        GridBoxAlignment->{"Columns" -> {{"Center"}}}], " ", "5", 
       SubscriptBox["y", "1"]}], "+", 
      RowBox[{"7", 
       SubscriptBox["y", "2"]}]}]},
    {
     RowBox[{"u", ".", "b", ".", "b", "."}]},
    {
     RowBox[{
      RowBox[{
       RowBox[{"2", 
        SubscriptBox["y", "1"]}], "+", 
       RowBox[{"3", 
        SubscriptBox["y", "2"]}]}], ">=", "42"}]},
    {
     RowBox[{
      RowBox[{
       RowBox[{"3", 
        SubscriptBox["y", "1"]}], "+", 
       RowBox[{"4", 
        SubscriptBox["y", "2"]}]}], ">=", "60"}]},
    {
     RowBox[{
      RowBox[{
       SubscriptBox["y", "1"], "+", 
       SubscriptBox["y", "2"]}], ">=", "18"}]},
    {
     RowBox[{
      SubscriptBox["y", "1"], ",", 
      RowBox[{
       SubscriptBox["y", "2"], ">=", "0"}]}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
  TraditionalForm]],ExpressionUUID->"bd5d5cc8-7fb3-c24f-9f9c-d6920eccf7c7"]], \
"Text",
 CellChangeTimes->{{3.978432226489748*^9, 
  3.978432309179554*^9}},ExpressionUUID->"75cc63c8-597e-f64c-87c9-\
b292373fa274"]
}, Open  ]],

Cell[CellGroupData[{

Cell["(b)", "Subsection",
 CellChangeTimes->{{3.9784323265056896`*^9, 
  3.9784323269674187`*^9}},ExpressionUUID->"a4d2f71c-87d2-2149-a639-\
74ac26cf25b9"],

Cell[TextData[{
 "For at opjektivfunktionens v\[AE]rdi skal blive 105 skal ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"5", 
      SubscriptBox["y", "1"]}], "+", 
     RowBox[{"7", 
      SubscriptBox["y", "2"]}]}], "=", "105"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fee57536-553f-1147-9168-8c5a5dcf51f5"],
 ". Hvis vi s\[AE]tter ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["y", "2"], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8e6fa1f8-c246-9f4e-9540-29b1a86fff49"],
 " ser vi at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["y", "1"], "=", "21"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f2eafe5e-2f99-db45-ad1d-fc5afde40665"],
 ". Vi unders\[OSlash]ger om dette er en mulig l\[OSlash]sning"
}], "Text",
 CellChangeTimes->{{3.9784323436162815`*^9, 
  3.9784324047686977`*^9}},ExpressionUUID->"108ed9f9-7187-8946-b5d9-\
794cce3113a9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AT", ":=", 
   RowBox[{"(", GridBox[{
      {"2", "3"},
      {"3", "4"},
      {"1", "1"}
     }], ")"}]}], ";", 
  RowBox[{"yv", ":=", 
   RowBox[{"(", GridBox[{
      {"21"},
      {"0"}
     }], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.978432406220068*^9, 3.9784324316597633`*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"6f30821b-d931-f94e-9023-9bc9272622ae"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AT", ".", "yv"}]], "Input",
 CellChangeTimes->{{3.9784324337051163`*^9, 3.9784324386425323`*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"be188f11-3822-db48-be2d-9f708ec165ef"],

Cell[BoxData[
 FormBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {"42"},
     {"63"},
     {"21"}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}], TraditionalForm]], "Output",
 CellChangeTimes->{3.97843243926626*^9},
 CellLabel->"Out[3]=",ExpressionUUID->"6d4e51db-7021-804c-b565-2925703450bf"]
}, Open  ]],

Cell[TextData[{
 "Vi ser alts\[ARing] at punktet opfylder alle bibetingelser og dermed m\
\[ARing] ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["y", "1"], ",", 
      SubscriptBox["y", "2"]}], ")"}], "=", 
    RowBox[{"(", 
     RowBox[{"21", ",", "0"}], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "83570a53-7a5c-4e41-9c7a-fb559814f4a1"],
 " v\[AE]re en mulig l\[OSlash]sning. St\[AE]rk dualitet siger at \
objektivfunktionen til det primal program ikke kan antage en h\[OSlash]jere v\
\[AE]rdi en objektivfunktionen til det duale program, og dermed kan det \
primale program ikke have en l\[OSlash]sning hvor v\[AE]rdien af \
objektivfunktionen er h\[OSlash]jere end 105. "
}], "Text",
 CellChangeTimes->{{3.9784324470305996`*^9, 
  3.9784325886108837`*^9}},ExpressionUUID->"de0cf07f-582c-494c-acb5-\
0ca8c8c283ee"]
}, Open  ]],

