Cell[TextData[{
 "F\[OSlash]r var reduced cost for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "c"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "27757de7-ffe0-1748-aa53-06475334dad5"],
 " lig nul, hvilket betyder at man kunne inkluderer denne i basen, uden at \
objektivv\[AE]rdien ville blive formindsket, men dette er ikke l\[AE]ngere \
tilf\[AE]ldet. Vi ser at der nu er en l\[OSlash]sning hvor reduced cost er \
negative, og man mister alts\[ARing] p\[ARing] at inkluderer denne i basen, \
og derfor har l\[OSlash]sningen faktisk \[AE]ndret sig kvalitativt. "
}], "Text",
 CellChangeTimes->{{3.980609490720579*^9, 
  3.980609568120199*^9}},ExpressionUUID->"42c55ed3-3437-0d44-9233-\
85929f122a52"],

Cell["\<\
Lad os kigge p\[ARing] hvad der sker hvis vi s\[AE]nker begr\[AE]nsningen p\
\[ARing] kreditscoren med 180+0.1\
\>", "Text",
 CellChangeTimes->{{3.9806095768162613`*^9, 
  3.9806096109080887`*^9}},ExpressionUUID->"1ca139ca-8b8d-f046-a749-\
fafbbaee891d"],

