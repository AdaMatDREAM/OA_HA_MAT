 FormBox[GridBox[{
    {GridBox[{
       {
        RowBox[{
         RowBox[{
          RowBox[{"-", "0.03"}], 
          SubscriptBox["s", "3"]}], "=", 
         RowBox[{"-", "0.5"}]}]}
