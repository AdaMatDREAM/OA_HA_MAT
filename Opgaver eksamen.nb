Cell[TextData[{
 "Da f\[ARing]r vi f\[OSlash]lgende l\[OSlash]sning, og vi ser at \
l\[OSlash]sningen har \[AE]ndret sig kvalitativt, eftersom det nu kun er ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "a"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "04d7f17d-7876-2745-901c-f8329daeae74"],
 " som er en del af basen. "
}], "Text",
 CellChangeTimes->{{3.9806096528248005`*^9, 
  3.9806096782497463`*^9}},ExpressionUUID->"d53ac9e4-cf9b-4846-91b3-\
320d00e10fa2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["f)", "Subsection",
 CellChangeTimes->{{3.980610103626793*^9, 
  3.980610104090063*^9}},ExpressionUUID->"510e8e53-c5fd-bb48-bfe6-\
0a6d1e5e7718"],

Cell["\<\
Landmand frederik er begejstret for frejas ide, og giver et tilskud p\[ARing] \
120.000 kroner, hvis ikke der produceres nogen atomkraftv\[AE]rker. \
F\[OSlash]r havde vi f\[OSlash]lgende problem\
\>", "Text",
 CellChangeTimes->{{3.980610111719591*^9, 3.980610129205982*^9}, {
  3.9806101674281635`*^9, 
  3.9806102039133835`*^9}},ExpressionUUID->"abb4dda7-3b03-a949-9a69-\
e1b56b7a13d4"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {GridBox[{
       {
        RowBox[{
         RowBox[{
          TemplateBox[<|"boxes" -> FormBox[
              UnderscriptBox["max", 
               RowBox[{
                 SubscriptBox[
                  StyleBox["x", "TI"], 
                  StyleBox["a", "TI"]], ",", 
                 SubscriptBox[
                  StyleBox["x", "TI"], 
                  StyleBox["b", "TI"]], ",", 
                 SubscriptBox[
                  StyleBox["x", "TI"], 
                  StyleBox["c", "TI"]]}], LimitsPositioning -> True], 
              TraditionalForm], "errors" -> {}, "input" -> 
            "\\max_{x_a,x_b,x_c}", "state" -> "Boxes"|>,
           "TeXAssistantTemplate"], "z"}], "=", 
         RowBox[{
          RowBox[{"4000", 
           SubscriptBox["x", "a"]}], "+", 
          RowBox[{"20", 
           SubscriptBox["x", "b"]}], "+", 
          RowBox[{"300", 
           SubscriptBox["x", "c"]}]}]}]}
      },
      GridBoxAlignment->{"Columns" -> {{"="}}}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
  TraditionalForm]],ExpressionUUID->"88e7e197-977b-1e45-bb58-81620e3a06a3"]], \
"Text",
 CellChangeTimes->{{3.9806026525752583`*^9, 
  3.9806027021298504`*^9}},ExpressionUUID->"e031e5db-3e51-9943-ae1a-\
8fe387ddc892"],

Cell["Og hertil er f\[OSlash]lgende begr\[AE]nsninger", "Text",
 CellChangeTimes->{{3.9806027053742695`*^9, 
  3.9806027122567883`*^9}},ExpressionUUID->"e2620f48-82ad-6549-8af7-\
f97e05ec6386"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {GridBox[{
       {
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", "Pris", ")"}], "  ", "100000", 
           SubscriptBox["x", "a"]}], "+", 
          RowBox[{"5000", 
           SubscriptBox["x", "b"]}], "+", 
          RowBox[{"15000", 
           SubscriptBox["x", "c"]}]}], "<=", "800000"}]},
       {
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", "Kvm", ")"}], "  ", "100", 
           SubscriptBox["x", "a"]}], "+", 
          SubscriptBox["x", "b"], "+", 
          RowBox[{"20", 
           SubscriptBox["x", "c"]}]}], "<=", "1000"}]},
       {
        RowBox[{
         RowBox[{
          RowBox[{"(", "SK", ")"}], " ", "-", 
          RowBox[{"10", 
           SubscriptBox["x", "a"]}], "+", 
          SubscriptBox["x", "b"], "+", 
          SubscriptBox["x", "c"]}], ">=", "100"}]}
      },
      GridBoxAlignment->{"Columns" -> {{"="}}}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
  TraditionalForm]],ExpressionUUID->"c02c08dc-dfed-8c43-81cc-24c743bec219"]], \
"Text",
 CellChangeTimes->{{3.980602715225111*^9, 
  3.980602866951271*^9}},ExpressionUUID->"f7f26116-b71b-4d40-83b5-\
2d35e071671f"],

Cell["Samt naturlige begr\[AE]nsinger", "Text",
 CellChangeTimes->{{3.980602875762539*^9, 
  3.980602880336075*^9}},ExpressionUUID->"d6d47864-18d3-b645-97e9-\
11f11a8ed636"],

Cell[TextData[Cell[BoxData[
 FormBox[GridBox[{
    {GridBox[{
       {
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", "NB", ")"}], 
           SubscriptBox["x", "a"]}], ">=", "0"}], ",", 
         RowBox[{
          SubscriptBox["x", "b"], ">=", "0"}], ",", 
         RowBox[{
          SubscriptBox["x", "c"], ">=", "0"}]}]}
      },
      GridBoxAlignment->{"Columns" -> {{"Center"}}}]}
   },
   GridBoxItemSize->{"Columns" -> {{
        Scaled[0.96]}}}], 
  TraditionalForm]],ExpressionUUID->"88080c9d-7dc3-f941-97fd-43ee30917abb"]], \
"Text",
 CellChangeTimes->{{3.980602870248598*^9, 
  3.980602871887888*^9}},ExpressionUUID->"cf8f8c3b-a34a-244d-87a5-\
5ab7cd1ae846"],

Cell[TextData[{
 "Hvis der bliver produceret nogen atomkraftv\[AE]rker, vil det betyde at \
budgettet stiger med 120 000 kroner. \n\nVi tilf\[OSlash]jer en ny variable ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", "\[Element]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "1"}], "}"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a3597f83-ec5d-9846-a328-5cf5d42a203f"],
 " og laver pivetingelsen p\[ARing] pris om til f\[OSlash]lgende "
}], "Text",
 CellChangeTimes->{{3.9806103089594193`*^9, 3.980610320337921*^9}, {
  3.9806104702684402`*^9, 3.9806104835446606`*^9}, {3.9806551490890293`*^9, 
